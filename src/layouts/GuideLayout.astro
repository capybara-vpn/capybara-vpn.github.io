---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';
import Related from '../components/Related.astro';
import GuideCta from '../components/GuideCta.astro';
import { b } from '../lib/url';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  crumbName: string;
  eyebrow: string;
  heading: string;
  lead: string;
  guidePath: string;
  articleLd: Record<string, unknown>;
  breadcrumbLd: Record<string, unknown>;
  articleSection: string;
  datePublished: string;
  dateModified: string;
  /** Path (without base) of the social preview image for this guide. */
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  crumbName,
  eyebrow,
  heading,
  lead,
  guidePath,
  articleLd,
  breadcrumbLd,
  articleSection,
  datePublished,
  dateModified,
  ogImage = 'og/og-image.jpg',
} = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} showFaq={false} ogType="article" ogImage={ogImage}>
  <meta property="article:published_time" content={datePublished} slot="head" />
  <meta property="article:modified_time" content={dateModified} slot="head" />
  <meta property="article:author" content="Capybara VPN" slot="head" />
  <meta property="article:section" content={articleSection} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd).replace(/</g, '\u003c')} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\u003c')} />
  <div id="top">
    <Header />
    <main id="main" tabindex="-1">
      <article class="relative mx-auto max-w-3xl px-4 pt-[168px] pb-8 sm:px-6 sm:pt-[156px] lg:pt-[168px]">
        <nav class="reveal text-[13px] text-[#8b98a5]" aria-label="Хлебные крошки">
          <ol class="flex flex-wrap items-center gap-2">
            <li class="flex items-center gap-2">
              <a href={`${b}/`} class="py-1 transition-colors hover:text-white">Главная</a>
              <span aria-hidden="true"> → </span>
            </li>
            <li><span class="text-[#9aa6b2]" aria-current="page">{crumbName}</span></li>
          </ol>
        </nav>
        <p class="eyebrow reveal mt-6">{eyebrow}</p>
        <h1 class="display reveal mt-4 text-4xl text-white sm:text-5xl">
          {heading}
        </h1>
        <p class="lead reveal mt-4 text-[16.5px]">
          {lead}
        </p>

        <div class="guide-body reveal mt-8">
          <slot />
        </div>

        <GuideCta />
        <Related current={guidePath} />
      </article>
    </main>
    <Footer />
    <MobileCta />
    <Consent />
  </div>
</BaseLayout>
