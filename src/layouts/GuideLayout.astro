---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';
import Related from '../components/Related.astro';
import GuideCta from '../components/GuideCta.astro';
import { b } from '../lib/url';
import { formatRuDate } from '../lib/dates';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  crumbName: string;
  eyebrow: string;
  heading: string;
  lead: string;
  guidePath: string;
  articleLd: Record<string, unknown>;
  breadcrumbLd: Record<string, unknown>;
  articleSection: string;
  datePublished: string;
  dateModified: string;
  /** Path (without base) of the social preview image for this guide. */
  ogImage?: string;
  /** One-sentence direct answer, shown right under the lead. */
  summary?: string;
  /** This guide's Q&A: rendered visibly and marked up as FAQPage. */
  faqs?: { q: string; a: string }[];
  /** Pass-through to BaseLayout: emit the Service JSON-LD block. */
  serviceLd?: boolean;
  /** Pass-through to BaseLayout: emit the three Product/Offer blocks. */
  productLd?: boolean;
  /** Social preview type; guides default to article, commerce pages may set website. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalPath,
  crumbName,
  eyebrow,
  heading,
  lead,
  guidePath,
  articleLd,
  breadcrumbLd,
  articleSection,
  datePublished,
  dateModified,
  ogImage = 'og/og-image.jpg',
  summary,
  faqs = [],
  serviceLd = false,
  productLd = false,
  ogType = 'article',
} = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType={ogType} ogImage={ogImage} pageFaqs={faqs.length ? faqs : undefined} showFaq={faqs.length > 0} serviceLd={serviceLd} productLd={productLd}>
  {/* Document pages without their own FAQ must not inherit the homepage
      FAQPage: markup must match visible content (audit 2026-11-11). With
      showFaq=false the homepage FAQ list stays empty and no FAQPage block
      is emitted. */}
  {ogType === 'article' && (
    <>
      <meta property="article:published_time" content={datePublished} slot="head" />
      <meta property="article:modified_time" content={dateModified} slot="head" />
      <meta property="article:author" content="Capybara VPN" slot="head" />
      <meta property="article:section" content={articleSection} slot="head" />
    </>
  )}
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd).replace(/</g, '\u003c')} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\u003c')} />
  {/* Reading progress: a 2px brand line across the very top, driven by the
      scroll handler (scaleX transform only — no layout work per frame). */}
  <div class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-[2.5px]" aria-hidden="true">
    <div id="read-progress" class="h-full w-full bg-gradient-to-r from-brand via-brand to-amber"></div>
  </div>
  <div id="top">
    <Header />
    <main id="main" tabindex="-1">
      <article class="relative mx-auto max-w-3xl px-4 pb-8 pt-[108px] sm:px-6">
        <nav class="reveal text-[13px]" aria-label="Хлебные крошки">
          <ol class="flex flex-wrap items-center gap-2">
            <li class="flex items-center gap-2">
              <a href={`${b}/`} class="rounded-md py-1 text-ink-3 transition-colors hover:text-brand">Главная</a>
              <span class="text-ink-3" aria-hidden="true">/</span>
            </li>
            <li><span class="text-ink-2" aria-current="page">{crumbName}</span></li>
          </ol>
        </nav>
        <p class="eyebrow reveal mt-7">{eyebrow}</p>
        <h1 class="display reveal mt-4 text-[clamp(1.8rem,1.1rem+2.6vw,2.9rem)] text-ink">
          {heading}
        </h1>
        <p class="lead reveal mt-5 text-[16.5px]">
          {lead}
        </p>

        <p class="reveal mono mt-4 text-[12px] text-ink-3">
          Обновлено{' '}
          <time datetime={dateModified}>{formatRuDate(dateModified)}</time>
        </p>

        {
          summary && (
            <div class="reveal mt-7 rounded-2xl border border-brand/30 px-5 py-4" style="background: linear-gradient(150deg, color-mix(in oklab, var(--brand) 10%, var(--surface)), var(--surface) 65%)">
              <p class="mono text-[10.5px] font-semibold uppercase tracking-[0.18em] text-brand">Коротко</p>
              <p class="mt-2 text-[15px] leading-relaxed text-ink">{summary}</p>
            </div>
          )
        }

        <div class="guide-body reveal mt-9">
          <slot />
        </div>

        {
          faqs.length > 0 && (
            <section class="reveal mt-14" aria-labelledby="guide-faq">
              <h2 id="guide-faq" class="text-[26px] font-bold tracking-[-0.02em] text-ink sm:text-[30px]">
                Частые вопросы
              </h2>
              <div class="mt-5 grid gap-2.5">
                {faqs.map((f) => (
                  <details class="faq spot">
                    <summary class="flex items-center justify-between gap-4 px-5 py-4 text-left">
                      {/* An honest h3 inside summary — valid per HTML spec,
                          consistent with the homepage FAQ. */}
                      <h3 class="text-[15.5px] font-semibold tracking-tight text-ink">{f.q}</h3>
                      <span class="plus" aria-hidden="true"></span>
                    </summary>
                    <div class="faq-body">
                      <div>
                        <p class="px-5 pb-5 text-[14.5px] leading-relaxed text-ink-2">{f.a}</p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <GuideCta />
        <Related current={guidePath} />
      </article>
    </main>
    <Footer />
    <MobileCta />
    <Consent />
  </div>
</BaseLayout>
