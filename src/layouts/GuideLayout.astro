---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';
import Related from '../components/Related.astro';
import GuideCta from '../components/GuideCta.astro';
import Icon from '../components/Icon.astro';
import { b } from '../lib/url';
import { formatRuDate } from '../lib/dates';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  crumbName: string;
  eyebrow: string;
  heading: string;
  lead: string;
  guidePath: string;
  articleLd: Record<string, unknown>;
  breadcrumbLd: Record<string, unknown>;
  articleSection: string;
  datePublished: string;
  dateModified: string;
  /** Path (without base) of the social preview image for this guide. */
  ogImage?: string;
  /** One-sentence direct answer, shown right under the lead. */
  summary?: string;
  /** This guide's Q&A: rendered visibly and marked up as FAQPage. */
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description,
  canonicalPath,
  crumbName,
  eyebrow,
  heading,
  lead,
  guidePath,
  articleLd,
  breadcrumbLd,
  articleSection,
  datePublished,
  dateModified,
  ogImage = 'og/og-image.jpg',
  summary,
  faqs = [],
} = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType="article" ogImage={ogImage} pageFaqs={faqs.length ? faqs : undefined}>
  <meta property="article:published_time" content={datePublished} slot="head" />
  <meta property="article:modified_time" content={dateModified} slot="head" />
  <meta property="article:author" content="Capybara VPN" slot="head" />
  <meta property="article:section" content={articleSection} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd).replace(/</g, '\u003c')} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\u003c')} />
  <div id="top">
    <Header />
    <main id="main" tabindex="-1">
      <article class="relative mx-auto max-w-3xl px-4 pt-[168px] pb-8 sm:px-6 sm:pt-[156px] lg:pt-[168px]">
        <nav class="reveal text-[13px] text-[#8b98a5]" aria-label="Хлебные крошки">
          <ol class="flex flex-wrap items-center gap-2">
            <li class="flex items-center gap-2">
              <a href={`${b}/`} class="py-1 transition-colors hover:text-white">Главная</a>
              <span aria-hidden="true"> → </span>
            </li>
            <li><span class="text-[#9aa6b2]" aria-current="page">{crumbName}</span></li>
          </ol>
        </nav>
        <p class="eyebrow reveal mt-6">{eyebrow}</p>
        <h1 class="display reveal mt-4 text-4xl text-white sm:text-5xl">
          {heading}
        </h1>
        <p class="lead reveal mt-4 text-[16.5px]">
          {lead}
        </p>

        <p class="reveal mt-3 text-[13px] text-[#8b98a5]">
          Обновлено{' '}
          <time datetime={dateModified}>{formatRuDate(dateModified)}</time>
        </p>

        {
          summary && (
            <div class="reveal mt-6 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#8fc3c4]">Коротко</p>
              <p class="mt-1.5 text-[15px] leading-relaxed text-[#c6d4d4]">{summary}</p>
            </div>
          )
        }

        <div class="guide-body reveal mt-8">
          <slot />
        </div>

        {
          faqs.length > 0 && (
            <section class="reveal mt-14" aria-labelledby="guide-faq">
              <h2 id="guide-faq" class="text-[26px] font-semibold tracking-tight text-white sm:text-[30px]">
                Частые вопросы
              </h2>
              <div class="mt-5 grid gap-3">
                {faqs.map((f) => (
                  <details class="faq">
                    <summary class="flex items-center justify-between gap-4 px-5 py-4 text-left">
                      <span class="text-[15.5px] font-semibold tracking-tight text-white">{f.q}</span>
                      <span class="chev flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 text-[#8fc3c4]">
                        <Icon name="chevron" class="h-4 w-4" />
                      </span>
                    </summary>
                    <div class="faq-body">
                      <div>
                        <p class="px-5 pb-5 text-[14.5px] leading-relaxed text-[#9aa6b2]">{f.a}</p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <GuideCta />
        <Related current={guidePath} />
      </article>
    </main>
    <Footer />
    <MobileCta />
    <Consent />
  </div>
</BaseLayout>
