---
import '../styles/global.css';
import { site, faqs, plans, facts } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  showFaq?: boolean;
  /** Per-page FAQ. When set, it replaces the homepage FAQ in the JSON-LD. */
  pageFaqs?: { q: string; a: string }[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Path (without base) of the social preview image. */
  ogImage?: string;
  /** Emit the Service block (home, /tarify/, /official/). */
  serviceLd?: boolean;
  /** Emit the three Product/Offer blocks (pages that show the plans). */
  productLd?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  canonicalPath = '/',
  showFaq = true,
  pageFaqs,
  ogType = 'website',
  noindex = false,
  ogImage = 'og/og-image.jpg',
  serviceLd = false,
  productLd = false,
} = Astro.props;

import { withBase } from '../lib/url';
import { fontFaces, preloadUrls } from '../lib/fonts';

// site.siteUrl is the full public URL (origin + base). Derive origin here so
// asset URLs never get a doubled base path (withBase already includes it).
const origin = new URL(site.siteUrl).origin;
const abs = (p: string) => `${origin}${withBase(p)}`;

const pageUrl = `${origin}${withBase(canonicalPath)}`;
const ogImageUrl = abs(ogImage);
// Markdown version of the current page: /ios/ -> /ios.md, / -> /index.md
const mdPath = canonicalPath === '/' ? 'index.md' : `${canonicalPath.replace(/\/$/, '')}.md`;
const gaId = site.gaId;
const orgId = `${site.siteUrl}/#organization`;

// Yandex Metrika loads inline in <head> on every page, as close to the top
// as possible — the owner's explicit decision (2026-11-07): the counter must
// fire even on a bounce. It is therefore NOT part of the consent gate; only
// GA4 stays behind it. Source: the standard Yandex.Metrika snippet.
const ymId = site.ymId;
const ymCounterScript = ymId
  ? `(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=${ymId}', 'ym');ym(${ymId}, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});`
  : '';

// A guide carries its own Q&A; the homepage uses the shared faqs[] list.
// One source per page keeps the visible block and the markup in sync.
const faqList: { q: string; a: string }[] = pageFaqs ?? (showFaq ? [...faqs] : []);

const jsonLdAll = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: 'Capybara VPN',
    url: site.siteUrl,
    logo: `${origin}${withBase(site.logo.src)}`,
    // Clean profile URLs only: sameAs represents the entity, so the bot goes
    // in without the partner start parameter and tracked deep links stay out.
    sameAs: [site.telegramProfile],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Capybara VPN',
    url: site.siteUrl,
    inLanguage: 'ru',
  },
  // Service/Product markup only on pages that actually describe the service
  // and show the plans — emitting offers on every guide page was markup
  // contradicting the content (audit 2026-11-07).
  ...(serviceLd
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Service',
          name: 'Capybara VPN',
          serviceType: 'VPN',
          url: pageUrl,
          description: description,
          provider: { '@id': orgId },
          areaServed: 'RU',
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: 'Тарифы Capybara VPN',
            itemListElement: plans.map((p) => ({
              '@type': 'Offer',
              name: `Capybara VPN — ${p.days} дней`,
              price: `${p.price}`,
              priceCurrency: 'RUB',
              availability: 'https://schema.org/InStock',
              // Purchase happens off-site, but the markup keeps pointing at
              // this domain's own pricing page — external partner links are
              // already in the visible CTAs.
              url: `${site.siteUrl}/tarify/`,
            })),
          },
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqList.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  // One Product per tariff: a single price each is what price-rich results
  // need, and it keeps the markup honest about the three separate plans.
  // No SoftwareApplication: the service has no app of its own (clients are
  // third-party), and markup must not claim one.
  ...(productLd
    ? plans.map((p) => ({
        '@context': 'https://schema.org',
        '@type': 'Product',
        '@id': `${site.siteUrl}/tarify/#${p.id}`,
        name: `Capybara VPN — ${p.days} дней`,
        description: `Подписка Capybara VPN на ${p.days} дней: безлимитный трафик, ${facts.locations} локаций, ${facts.protocol}.`,
        category: 'VPN service',
        inLanguage: 'ru',
        // Without an image Google treats the product markup as incomplete: the
        // Rich Results Test flags a missing `image` as a critical error. The
        // brand mark is the product here — a VPN has no other picture.
        image: [`${site.siteUrl}/logo-320.png`],
        brand: { '@type': 'Brand', name: 'Capybara VPN' },
        url: `${site.siteUrl}/tarify/`,
        offers: {
          '@type': 'Offer',
          name: `Тариф ${p.days} дней`,
          price: `${p.price}`,
          priceCurrency: 'RUB',
          availability: 'https://schema.org/InStock',
          itemCondition: 'https://schema.org/NewCondition',
          url: `${site.siteUrl}/tarify/`,
          seller: { '@id': orgId },
        },
      }))
    : []),
];
// The FAQPage block is only emitted when the page actually shows a Q&A
// (homepage or a guide) — the 404 page shows none, so it gets no markup.
const jsonLd = jsonLdAll.filter(
  (x) => faqList.length > 0 || (x as Record<string, unknown>)["@type"] !== "FAQPage"
);

// Approximations of the two theme backgrounds, for the browser chrome only.
const themeColorLight = '#f7f5f1';
const themeColorDark = '#151b20';

// Theme before first paint: always dark unless the visitor has explicitly
// switched to light (the choice is remembered). The system preference is
// deliberately ignored — the owner's call (2026-11-13): dark is the brand
// look, light is opt-in via the header toggle. ?theme=light|dark overrides
// for one view (screenshots, debugging) without touching the stored choice.
const themeBoot = `(function(){try{var t=localStorage.getItem('capybara-theme');if(t!=='light'){t='dark';}var q=new URLSearchParams(location.search).get('theme');if(q==='light'||q==='dark'){t=q;}document.documentElement.dataset.theme=t;var m=document.getElementById('meta-theme-color');if(m){m.content=t==='dark'?'${themeColorDark}':'${themeColorLight}';}}catch(e){document.documentElement.dataset.theme='dark';}})();`;
---

<!doctype html>
<html lang="ru" data-type="software" data-ga-id={gaId} data-ym-id={site.ymId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="site-kind" content="software" />
    <meta name="page-type" content="software" />
    {/* Browser chrome color for the default (dark) theme; the boot script
        right below repaints it when the resolved theme is light. */}
    <meta name="theme-color" id="meta-theme-color" content={themeColorDark} />

    {/* Theme must exist before the first paint: dark is the brand default,
        light only when the visitor's system asks for it. ?theme=light|dark
        overrides for one view (screenshots, debugging) without touching the
        stored choice. Without JS the CSS falls back to the same rule. */}
    <script is:inline set:html={themeBoot} />

    {/* Yandex Metrika: inline, first thing after the base metas so it starts
        loading before anything else (owner decision 2026-11-07). */}
    {ymCounterScript && <script is:inline set:html={ymCounterScript} />}
    {/*
      Scroll-reveals are set up here, inline, instead of in the client
      module: the module is a separate file, so on a slow connection it
      arrives after the page has painted and the sections below the fold
      stay invisible for seconds (Speed Index 4s). This runs at
      DOMContentLoaded — no network round-trip in between.
    */}
    <script is:inline>
      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        function setup() {
          var els = document.querySelectorAll('.reveal');
          if (reduce || !('IntersectionObserver' in window)) {
            for (var k = 0; k < els.length; k++) els[k].classList.add('is-visible');
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  entries[i].target.classList.add('is-visible');
                  io.unobserve(entries[i].target);
                }
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
          );
          for (var j = 0; j < els.length; j++) io.observe(els[j]);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setup);
        } else {
          setup();
        }
      })();
    </script>
    <style is:inline set:html={fontFaces} />
    {preloadUrls.map((u) => (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={u} />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Capybara VPN" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {/* A noindex page must not declare a canonical: pointing the 404 at "/"
        sent conflicting signals. Canonical only for indexable pages. */}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" type="application/xml" href={withBase('sitemap-index.xml')} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {/* Browser chrome color follows the active theme (see boot script + theme toggle). */}
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Capybara VPN" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Capybara VPN — быстрый интернет без лишней сложности" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <link rel="alternate" type="text/plain" title="Capybara VPN — кратко для ИИ" href={withBase('llms.txt')} />
    <link rel="alternate" type="text/plain" title="Capybara VPN — полный текст для ИИ" href={withBase('llms-full.txt')} />
    {
      !noindex && (
        <>
          {/* Markdown version of this page for agents (llms.txt spec). */}
          <link rel="alternate" type="text/markdown" href={withBase(mdPath)} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Capybara VPN — быстрый интернет без лишней сложности" />

    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32.png')} />
    <!-- 192px is a multiple of 48px: the size Google recommends for the SERP favicon. -->
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('icon-192.png')} />
    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <!-- The primary CTA opens Telegram: warm the connection up front. -->
    <link rel="preconnect" href="https://t.me" crossorigin />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />

    <!-- GA4 library is injected only after analytics consent is granted
         (see configureGA in src/scripts/site.ts), so no request leaves
         the browser before the visitor agrees. Consent Mode still
         defaults to denied below. -->

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} />
    <slot name="head" />
    <noscript><style>.reveal{opacity:1!important;transform:none!important}#consent-manage-wrap{display:none!important}</style></noscript>
  </head>
  <body class="noise min-h-screen min-h-dvh antialiased">
    <a href="#main" class="skip-link">Перейти к содержимому</a>
    {ymId && (
      <noscript>
        <div>
          <img src={`https://mc.yandex.ru/watch/${ymId}`} style="position:absolute; left:-9999px;" alt="" />
        </div>
      </noscript>
    )}
    <div id="cursor-glow" aria-hidden="true"></div>
    <slot />

    <!-- Consent Mode defaults: denied until user agrees -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
    </script>
    <script>
      import '../scripts/site.ts';
    </script>
    {/*
      Scroll-reveals are driven by the client script. On a slow mobile
      connection that script arrives after the page has painted, and the
      first screen stays half empty for seconds (Speed Index 4s). This inline
      timer — no extra request, it runs as soon as the DOM is parsed — shows
      whatever is already on screen if the script has not got there yet.
      Elements below the fold keep their scroll-reveal.
    */}
    <script is:inline>
      setTimeout(function () {
        var list = document.querySelectorAll('.reveal');
        for (var i = 0; i < list.length; i++) {
          var r = list[i].getBoundingClientRect();
          if (r.top < window.innerHeight * 1.2) list[i].classList.add('is-visible');
        }
      }, 1000);
    </script>
  </body>
</html>
