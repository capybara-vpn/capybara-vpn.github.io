---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';

const title = 'Что такое VLESS: протокол Capybara VPN простыми словами';
const description =
  'VLESS — современный протокол VPN: быстрый, стабильный, устойчивый к блокировкам. Объясняем просто + где он уже настроен.';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  image: `${site.siteUrl}/og/og-image.jpg`,
  mainEntityOfPage: `${site.siteUrl}/vless/`,
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  datePublished: '2026-09-29',
  dateModified: '2026-10-06',
  about: 'Протокол VLESS',
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'VLESS', item: `${site.siteUrl}/vless/` },
  ],
};
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath="/vless/"
  crumbName="VLESS"
  eyebrow="Гид · Технологии"
  heading="Что такое VLESS — простыми словами"
  lead="VLESS — современный протокол подключения, на котором работает Capybara VPN. Именно он отвечает за то, что видео не виснет, а соединение не отваливается вечером."
  guidePath="/vless/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Технологии"
  datePublished="2026-09-29"
  dateModified="2026-10-06"
>
          <h2>Зачем вообще нужен протокол</h2>
          <p>
            VPN — это не волшебство, а договорённость: как ваше устройство упаковывает
            трафик и разговаривает с сервером. Старые протоколы легко узнать и замедлить —
            отсюда классика: «VPN работает через раз». Современные протоколы лишены
            этих слабостей.
          </p>

          <h2>Чем VLESS лучше</h2>
          <ul>
            <li><strong>Скорость.</strong> Минимальные накладные расходы: там, где старые протоколы режут скорость вдвое, VLESS держит почти полную.</li>
            <li><strong>Стабильность.</strong> Соединение не рвётся и не «умирает» в час пик.</li>
            <li><strong>Устойчивость.</strong> Трафик выглядит как обычный, его сложнее детектить и резать — соединение держится даже при белых списках.</li>
          </ul>

          <h2>Протокол — это половина дела</h2>
          <p>
            Вторая половина — серверы. Толку от хорошего протокола на перегруженном
            сервере мало. Поэтому смотрите на три вещи: количество серверов и локаций
            (десятки, а не штуки), ширину каналов (гигабиты) и безлимит трафика.
          </p>
          <blockquote>
            Capybara VPN: VLESS + 38 локаций + 100+ серверов с каналами
            до 10 Гбит/с. Протокол уже выбран и настроен — вам ничего делать не нужно.
          </blockquote>

          <h2>Нужно ли в этом разбираться</h2>
          <p>
            Нет. Вы открываете <a href={site.telegramUrl} target="_blank" rel="noopener noreferrer sponsored nofollow">Telegram-бота</a>
            или <a href={site.browserUrl} target="_blank" rel="noopener noreferrer sponsored nofollow">браузерную версию</a>,
            выбираете локацию — и пользуетесь. VLESS работает внутри, незаметно.
            А проверить всё можно бесплатно: первый день и 10 ГБ на тест, карта не нужна.
          </p>
</GuideLayout>
