---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Безопасность и приватность с VPN: что даёт и чего не даёт';
const description =
  'Что VPN действительно защищает, а что нет: шифрование канала, адрес, логи. Без иллюзий — список из защищённого и незащищённого.';
const ogImage = '/og/bezopasnost-vpn.jpg';

const canonicalPath = '/bezopasnost-vpn/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/bezopasnost-vpn/`,
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  datePublished: '2026-10-21',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Безопасность', item: `${site.siteUrl}/bezopasnost-vpn/` },
  ],
};

const faqs = [
  {
    q: 'Защищает ли VPN от вирусов?',
    a: 'Нет, это разные задачи. VPN шифрует канал и прячет ваш адрес, но не сканирует файлы на вредоносный код. Антивирус нужен отдельно.',
  },
  {
    q: 'Видит ли провайдер, какие сайты я открываю?',
    a: 'Через VPN он видит только зашифрованный поток к серверу VPN и объём трафика. Содержимое и адреса сайтов — нет.',
  },
  {
    q: 'Кто видит мой IP?',
    a: 'Сайты видят адрес VPN-сервера, а не ваш домашний. При этом сервис, в который вы вошли, по-прежнему вас видит — VPN не делает вас анонимным для него.',
  },
  {
    q: 'Что с логами?',
    a: 'Сервис заявляет, что не хранит историю посещений, IP-адреса и DNS-запросы: серверы работают в режиме RAM-only, без долговременных логов.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Безопасность"
  eyebrow="Гид · Приватность"
  heading="Что VPN защищает, а что — нет"
  lead="Без маркетинговых обещаний: список из того, что VPN действительно даёт, и того, что не защищает ни от чего. Это честнее и полезнее."
  guidePath="/bezopasnost-vpn/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Приватность"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="VPN защищает канал и прячет домашний адрес, но не делает вас анонимным для сервисов, не заменяет антивирус и не ускоряет интернет."
  faqs={faqs}
>
  <h2>Что VPN защищает</h2>
  <ul>
    <li>
      <strong>Содержимое трафика.</strong> По дороге от устройства до сервера
      данные зашифрованы: провайдер или владелец публичного Wi-Fi видят
      только «мешанину», а не ваши запросы.
    </li>
    <li>
      <strong>Ваш домашний адрес.</strong> Сайты видят адрес VPN-сервера, а не
      адрес вашей квартиры. Это меняет, например, то, как вас видят сервисы,
      которые привязывают сессию к адресу.
    </li>
    <li>
      <strong>Часть домашней сети.</strong> Если подключение поднято на роутере,
      через него идут все устройства — включая телевизор и гостевые телефоны.
    </li>
  </ul>

  <h2>Чего VPN не делает</h2>
  <ul>
    <li>
      <strong>Не делает вас анонимным.</strong> Аккаунт, в который вы вошли,
      по-прежнему виден сервису, которому вы вошли.
    </li>
    <li>
      <strong>Не защищает от вредоносного ПО.</strong> Антивирус и VPN решают
      разные задачи.
    </li>
    <li>
      <strong>Не спасает от фишинга и поддельных сайтов.</strong> Злоумышленник
      всё ещё может прислать вам ссылку — VPN не отличит её от настоящей.
    </li>
    <li>
      <strong>Не ускоряет интернет.</strong> Наоборот, при перегруженном
      сервере скорость может просесть — поэтому локацию стоит переключать.
    </li>
  </ul>

  <h2>Что с логами</h2>
  <p>
    Сервис заявляет, что не хранит историю посещений, IP-адреса и DNS-запросы:
    серверы работают в режиме RAM-only, без долговременных логов. Это заявление
    о политике сервиса, а не техническая гарантия со стороны пользователя.
  </p>

  <h2>Практический чек-лист</h2>
  <ol>
    <li>Включайте VPN в публичных сетях — Wi-Fi в кафе, аэропорту, общежитии.</li>
    <li>Не путайте VPN и антивирус: первое про канал, второе про файлы.</li>
    <li>Держите разные пароли на разных сервисах — VPN этого не делает.</li>
    <li>На домашней сети поднимите VPN один раз на роутере.</li>
  </ol>

  <blockquote>
    Проверить всё это можно на бесплатном дне: 10 ГБ трафика без карты. Базовые
    принципы работы VPN — в гайде <a href={`${b}/chto-takoe-vpn/`}>что такое
    VPN</a>.
  </blockquote>
</GuideLayout>
