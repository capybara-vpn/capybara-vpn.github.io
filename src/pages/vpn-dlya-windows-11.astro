---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'VPN на Windows 11: подключение за пару минут';
const description =
  'Как подключить VPN на Windows 11: получаете готовую ссылку для VPN-клиента, добавляете её и включаете соединение. Что делать, если клиент не подключается.';
const ogImage = '/og/vpn-dlya-windows-11.jpg';

const canonicalPath = '/vpn-dlya-windows-11/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/vpn-dlya-windows-11/`,
  datePublished: '2026-10-21',
  dateModified: modified,
  totalTime: 'PT3M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'RUB', value: '249' },
  step: [
    { '@type': 'HowToStep', name: 'Откройте сервис в браузере', text: 'Зайдите на сайт Capybara VPN на компьютере — или через Telegram-бот, если так удобнее.' },
    { '@type': 'HowToStep', name: 'Выберите устройство Windows', text: 'Первый день бесплатно: 10 ГБ трафика, карта не нужна.' },
    { '@type': 'HowToStep', name: 'Получите ссылку', text: 'Сервис выдаёт готовую ссылку с вашими серверами и локациями.' },
    { '@type': 'HowToStep', name: 'Добавьте ссылку в VPN-клиент', text: 'Откройте VPN-клиент на компьютере, вставьте ссылку и выберите локацию.' },
    { '@type': 'HowToStep', name: 'Включите соединение', text: 'Нажмите «Подключиться» в клиенте и откройте сайт, который раньше не открывался.' },
  ],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'VPN на Windows 11', item: `${site.siteUrl}/vpn-dlya-windows-11/` },
  ],
};

const faqs = [
  {
    q: 'Нужно ли ставить VPN в настройках Windows?',
    a: 'Нет. Встроенная форма «Добавить VPN» в Windows рассчитана на протоколы IKEv2 и L2TP, где всё вводится руками. В Capybara VPN используется другой протокол, и сервис выдаёт готовую ссылку — её добавляют в VPN-клиент, и всё.',
  },
  {
    q: 'Нужны ли права администратора?',
    a: 'Как правило, нет: добавление подписки в клиент не требует прав администратора. Но в некоторых организациях установка программ ограничена политикой — тогда настройку должен выполнить IT-отдел.',
  },
  {
    q: 'Клиент не подключается, что делать?',
    a: 'Проверьте, что ссылка добавилась целиком, что в клиенте выбрана локация и что соединение действительно включено. Если не помогает — смените локацию: сети в офисе, дома и в гостевых Wi-Fi фильтруют по-разному.',
  },
  {
    q: 'Конфликтует ли VPN с корпоративным?',
    a: 'Часто да: два VPN-клиента одновременно работать не могут, и второй вытесняет первый. Если на компьютере уже настроен корпоративный клиент, его нужно выключить — иначе не подключится ни один из двух.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Windows 11"
  eyebrow="Гид · Windows 11"
  heading="VPN на Windows 11"
  lead="Схема на Windows 11 та же, что на Windows 10: сервис выдаёт готовую ссылку, вы добавляете её в VPN-клиент и включаете соединение."
  guidePath={canonicalPath}
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Установка"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Подключение на Windows 11 занимает пару минут: сервис выдаёт готовую ссылку с вашими серверами, вы добавляете её в VPN-клиент, выбираете локацию из 38 и нажимаете «Подключиться»."
  faqs={faqs}
>
  <h2>Как подключается VPN на компьютере</h2>
  <p>
    Соединение выполняет VPN-клиент — программа, которая держит туннель. Ваша
    задача: получить в сервисе готовую ссылку с вашими серверами, добавить её в
    клиент и включить соединение. Вручную сервер, порт и ключи вводить не нужно,
    все параметры уже зашиты в ссылку.
  </p>
  <p>
    Форму «Добавить VPN» из настроек Windows для этого не нужна: она рассчитана
    на IKEv2 и L2TP, где всё вводится руками, и на наш протокол не
    распространяется.
  </p>

  <h2>Коротко: пять шагов</h2>
  <ol>
    <li>Откройте сайт сервиса в браузере на компьютере (или Telegram-бот).</li>
    <li>Выберите устройство <strong>Windows</strong> — первый день бесплатно, 10 ГБ, карта не нужна.</li>
    <li>Получите готовую ссылку для VPN-клиента.</li>
    <li>Откройте VPN-клиент, вставьте ссылку и выберите локацию.</li>
    <li>Нажмите «Подключиться» и проверьте: откройте сайт, который раньше не открывался.</li>
  </ol>
  <p>
    Общая инструкция для всех версий Windows — в гайде
    <a href={`${b}/windows/`}>«Настройка на Windows»</a>.
  </p>

  <h2>Что стоит знать про Windows 11</h2>
  <ul>
    <li><strong>Клиент живёт в трее.</strong> После подключения значок остаётся рядом с часами: там же видно статус, таймер трафика и кнопку отключения.</li>
    <li><strong>Права администратора обычно не нужны.</strong> Но в компаниях установка программ бывает ограничена политикой — тогда настройку делает IT-отдел.</li>
    <li><strong>Автозапуск можно включить.</strong> Клиенты умеют поднимать соединение при старте Windows, чтобы не включать VPN вручную каждый раз.</li>
    <li><strong>Не запускайте два клиента.</strong> Корпоративный VPN и наш конфликтуют: активным останется один, а второй будет молча переподключаться.</li>
  </ul>

  <h2>Если клиент не подключается</h2>
  <ul>
    <li><strong>Ссылка добавилась не полностью.</strong> Скопируйте её заново целиком и вставьте ещё раз.</li>
    <li><strong>Соединение включено, но сайты не открываются.</strong> Смените локацию: одни серверы перегружены, а в разных сетях фильтрация разная.</li>
    <li><strong>Антивирус или файрвол режет клиент.</strong> Корпоративные антивирусы иногда блокируют незнакомые сетевые драйверы. Поэтому стоит начать с бесплатного дня и проверить VPN на рабочем компьютере до оплаты.</li>
    <li><strong>Один клиент вытесняет другой.</strong> Выключите корпоративный VPN и все расширения-прокси в браузере.</li>
  </ul>
  <p>
    Полный разбор — в гайде <a href={`${b}/ne-rabotaet/`}>«Если не работает»</a>.
  </p>

  <blockquote>
    Первый день — 10 ГБ бесплатно, карта не нужна. Удобный момент проверить
    VPN именно на рабочем компьютере: корпоративные сети фильтруют VPN чаще
    всего.
  </blockquote>
</GuideLayout>
