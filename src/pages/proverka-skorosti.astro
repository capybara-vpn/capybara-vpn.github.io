---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Как проверить скорость Capybara VPN: замер без лишних сервисов';
const description =
  'Как проверить скорость VPN на практике: на что смотреть, какие цифры считаются нормой и почему скорость зависит от локации и нагрузки.';
const ogImage = '/og/proverka-skorosti.jpg';

const canonicalPath = '/proverka-skorosti/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/proverka-skorosti/`,
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  datePublished: '2026-10-21',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Скорость', item: `${site.siteUrl}/proverka-skorosti/` },
  ],
};

const faqs = [
  {
    q: 'Какая скорость считается нормальной?',
    a: 'Смотрите не на абсолютную цифру, а на разницу: с VPN должно быть заметно быстрее, чем без него. Если разницы нет, значит упирается в ваш канал или выбрана загруженная локация.',
  },
  {
    q: 'Замедляет ли VPN?',
    a: 'На практике нет: лишний переход добавляет доли секунды. Просадка появляется, когда сервер перегружен или канал слабый, — и лечится переключением локации.',
  },
  {
    q: 'Почему скорость прыгает?',
    a: 'Нагрузка на сервер меняется в течение дня, поэтому одна и та же локация утром и вечером может давать разный результат. Это нормально, и именно поэтому локацию стоит переключать.',
  },
  {
    q: 'Где в сервисе указан номер локации?',
    a: 'В списке локаций в самом сервисе: там же, где включается соединение. Выбрать другую можно в любой момент без переустановки профиля.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Скорость"
  eyebrow="Гид · Скорость"
  heading="Как проверить скорость VPN и что значат цифры"
  lead="Проверять скорость по рекламе бессмысленно — замеряйте на своих устройствах. Разбираем, как сделать замер честно и что с результатом делать."
  guidePath="/proverka-skorosti/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Основы"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Скорость VPN проверяют на своих устройствах: смотрите на разницу с обычным интернетом и на стабильность, а не на пиковые цифры."
  faqs={faqs}
>
  <h2>Зачем вообще мерить</h2>
  <p>
    Заявленные «до 10 Гбит/с» — это потолок канала, а не ваша скорость.
    Реальный результат зависит от вашего интернета, нагрузки на сервере и
    выбранной локации. Поэтому единственный полезный замер — тот, который вы
    делаете на своём устройстве и в своей сети.
  </p>

  <h2>Самый честный способ</h2>
  <ol>
    <li>
      <strong>Включите VPN</strong> и выберите локацию.
    </li>
    <li>
      <strong>Загрузите объёмный файл</strong> — из сетевого хранилища или
      крупного обновления. По времени загрузки сразу видно, «летит» или
      «ползёт».
    </li>
    <li>
      <strong>Откройте видео</strong> в том качестве, которым пользуетесь
      обычно. Если картинка не проседает и не подтормаживает — соединение
      справляется.
    </li>
    <li>
      <strong>Повторите на другой локации</strong>, если результат не устроил.
      Это единственный способ сравнить варианты честно.
    </li>
  </ol>

  <h2>На что смотреть</h2>
  <ul>
    <li>
      <strong>Разницу с обычным интернетом.</strong> Если с VPN быстрее — всё
      работает. Если так же — упирается в ваш канал, а не в VPN.
    </li>
    <li>
      <strong>Стабильность, а не пик.</strong> Ровные 30 Мбит/с полезнее
      скачков от 5 до 100: по «горкам» страдает видео и звонки.
    </li>
    <li>
      <strong>Отклик.</strong> Если страницы открываются с задержкой, а сеть
      при этом «быстрая», проблема в маршруте — помогает другая локация.
    </li>
  </ul>

  <h2>Если скорость не устраивает</h2>
  <p>
    Переключите локацию — их 38, и разница между ними бывает заметной. Если
    не помогло, проверьте, не включено ли на устройстве ещё что-то: другой
    VPN-клиент, агент или прокси могут перехватывать трафик. Подробнее —
    в гайде <a href={`${b}/kak-vybrat-lokaciyu/`}>про выбор локации</a> и
    <a href={`${b}/ne-rabotaet/`}>про проблемы с подключением</a>.
  </p>

  <blockquote>
    Проверить всё это можно на бесплатном дне: 10 ГБ трафика без карты — их
    как раз хватает на несколько замеров.
  </blockquote>
</GuideLayout>
