---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Как включить VPN на телефоне: iPhone и Android за 5 минут';
const description =
  'Пошаговая инструкция: как включить VPN на iPhone и Android через Capybara VPN. Готовая ссылка для VPN-клиента, ручная настройка не нужна, пять минут на всё.';
const ogImage = '/og/kak-vklyuchit-vpn-na-telefone.jpg';

const canonicalPath = '/kak-vklyuchit-vpn-na-telefone/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/kak-vklyuchit-vpn-na-telefone/`,
  datePublished: '2026-10-21',
  dateModified: modified,
  totalTime: 'PT5M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'RUB', value: '249' },
  step: [
    { '@type': 'HowToStep', name: 'Откройте Capybara VPN', text: 'Зайдите через Telegram-бота или прямо в браузере — регистрация для первого подключения не нужна.' },
    { '@type': 'HowToStep', name: 'Выберите устройство', text: 'Укажите, на каком устройстве будет работать VPN: iPhone, iPad или Android-смартфон.' },
    { '@type': 'HowToStep', name: 'Получите ссылку для VPN-клиента', text: 'Сервис выдаёт готовую ссылку с вашими серверами и локациями — вручную сервер, порт и ключи вводить не нужно.' },
    { '@type': 'HowToStep', name: 'Добавьте ссылку в VPN-клиент', text: 'Откройте VPN-клиент на телефоне, добавьте полученную ссылку и выберите локацию.' },
    { '@type': 'HowToStep', name: 'Включите соединение', text: 'Нажмите «Подключиться» в клиенте и откройте любой сайт — первый день работает бесплатно: 10 ГБ, карта не нужна.' },
  ],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Как включить VPN на телефоне', item: `${site.siteUrl}/kak-vklyuchit-vpn-na-telefone/` },
  ],
};

const faqs = [
  {
    q: 'Нужно ли устанавливать приложение из App Store?',
    a: 'Нужен VPN-клиент — программа, через которую идёт соединение. Сервис выдаёт готовую ссылку с вашими серверами: вы добавляете её в клиент, выбираете локацию и нажимаете «Подключиться». Руками ничего настраивать не нужно.',
  },
  {
    q: 'Как включить VPN на iPhone?',
    a: 'Откройте VPN-клиент, добавьте ссылку, которую вы получили в сервисе, выберите локацию из 38 и включите соединение. Всё управление — внутри клиента: там же видно статус подключения и таймер трафика.',
  },
  {
    q: 'Как включить VPN на Android?',
    a: 'Схема та же: откройте VPN-клиент, вставьте полученную в сервисе ссылку, выберите локацию и включите соединение. Клиент работает в фоне и держит туннель, пока вы его не выключили.',
  },
  {
    q: 'Будет ли VPN садить батарею?',
    a: 'Расход есть, но небольшой: соединение через клиент нагружает сеть, а не процессор. Если телефон всё равно живёт недолго, проверьте, не работает ли одновременно ещё один VPN-клиент — они конфликтуют.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="VPN на телефоне"
  eyebrow="Гид · Телефон"
  heading="Как включить VPN на телефоне"
  lead="Пять минут и никакой ручной настройки: сервис выдаёт готовую ссылку для VPN-клиента, а дальше вы просто выбираете локацию и включаете соединение."
  guidePath={canonicalPath}
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Установка"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Подключение на телефоне занимает пять минут: сервис выдаёт готовую ссылку с вашими серверами, вы добавляете её в VPN-клиент, выбираете локацию из 38 и нажимаете «Подключиться». Ручной настройки нет."
  faqs={faqs}
>
  <h2>Как это устроено</h2>
  <p>
    VPN-сервис отвечает за серверы, локации и протокол, а соединение
    выполняет VPN-клиент — программа на телефоне. Всё, что нужно сделать вам,
    умещается в одно действие: добавить в клиент ссылку, которую выдаёт сервис.
  </p>
  <p>
    Раньше для ручной настройки приходилось вводить сервер, порт, логин и пароль,
    а потом разбираться с ошибками. Здесь этого нет: сервис отдаёт готовую
    ссылку со всеми параметрами, клиент подхватывает её сам, а от вас остаётся
    выбрать локацию и нажать «Подключиться».
  </p>

  <h2>Пять шагов</h2>
  <ol>
    <li><strong>Откройте сервис.</strong> Telegram-бот или браузерная версия — на выбор. Регистрация для первого подключения не нужна.</li>
    <li><strong>Выберите устройство.</strong> iPhone, iPad или Android-смартфон.</li>
    <li><strong>Получите ссылку.</strong> Сервис выдаёт её после выбора устройства — в ней уже ваши серверы и локации.</li>
    <li><strong>Добавьте ссылку в VPN-клиент.</strong> В клиенте есть пункт «добавить подписку» или «добавить сервер» — вставьте ссылку и подтвердите.</li>
    <li><strong>Выберите локацию и включите соединение.</strong> В клиенте же видно статус подключения и расход трафика.</li>
  </ol>
  <p>
    Подробности по устройствам: <a href={`${b}/ios/`}>iPhone и iPad</a>,
    <a href={`${b}/android/`}>Android</a>. Если раньше не пользовались VPN —
    начните с <a href={`${b}/dlya-novichkov/`}>гайда для новичков</a>.
  </p>

  <h2>iPhone и iPad</h2>
  <p>
    На iPhone и iPad схема одинаковая: открываете VPN-клиент, добавляете
    полученную в сервисе ссылку, выбираете локацию и включаете соединение.
    Клиент остаётся в фоне и держит туннель, пока вы его не выключили, — то
    есть после первого раза переключаться ничего не нужно, только нажимать
    «Подключиться» заново.
  </p>
  <p>Подробная инструкция по шагам — в гайде <a href={`${b}/ios/`}>«Настройка на iOS»</a>.</p>

  <h2>Android</h2>
  <p>
    На Android всё то же самое: ссылка из сервиса добавляется в клиент, локация
    выбирается внутри него, соединение включается кнопкой. Отдельная тонкость
    Android — фоновый режим: клиент должен оставаться разрешённым в фоне, иначе
    система может усыпить его вместе с туннелем.
  </p>
  <p>Подробная инструкция — в гайде <a href={`${b}/android/`}>«Настройка на Android»</a>.</p>

  <h2>Если что-то пошло не так</h2>
  <ul>
    <li><strong>Ссылка не добавилась.</strong> Проверьте, что скопировали её целиком, и что в клиенте выбран пункт добавления именно по ссылке.</li>
    <li><strong>Соединение включилось, а сайты не открываются.</strong> Смените локацию: часть серверов перегружена, их 38.</li>
    <li><strong>Работает дома, не работает на улице.</strong> Мобильные операторы фильтруют по-разному; попробуйте другую локацию.</li>
    <li><strong>Интернет пропал совсем.</strong> Выключите соединение в клиенте. Одновременно работающие VPN-клиенты конфликтуют — оставьте только один.</li>
  </ul>
  <p>
    Разбор по шагам — в гайде <a href={`${b}/ne-rabotaet/`}>«Если не работает»</a>.
  </p>

  <blockquote>
    Первый день — 10 ГБ бесплатно, карта не нужна. Проверьте на телефоне то,
    ради чего ищете VPN, — и решите, нужен ли вам платный тариф.
  </blockquote>
</GuideLayout>
