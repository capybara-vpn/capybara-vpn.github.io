---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Benefits from '../components/Benefits.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Platforms from '../components/Platforms.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';

import { b } from '../lib/url';
---

<BaseLayout canonicalPath="/">
  <meta name="yandex-verification" content="612dfbb44cbe9e12" slot="head" />
  <link rel="preload" slot="head" as="image" href={`${b}/logo-320.webp`} type="image/webp" fetchpriority="high" />
  <div id="top">
    <Header />
    <main id="main" tabindex="-1">
      <Hero />
      <TrustStrip />
      <ProblemSolution />
      <Benefits />
      <HowItWorks />
      <Platforms />
      <Pricing />
      <Faq />
      <FinalCta />
    </main>
    <Footer />
    <MobileCta />
    <Consent />
  </div>
</BaseLayout>
