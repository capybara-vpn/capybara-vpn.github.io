---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Benefits from '../components/Benefits.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Platforms from '../components/Platforms.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';
---

<BaseLayout canonicalPath="/">
  <div id="top">
    <Header />
    <main id="main">
      <Hero />
      <TrustStrip />
      <ProblemSolution />
      <Benefits />
      <HowItWorks />
      <Platforms />
      <Pricing />
      <Faq />
      <FinalCta />
    </main>
    <Footer />
    <MobileCta />
    <Consent />
  </div>
</BaseLayout>
