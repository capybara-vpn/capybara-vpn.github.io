---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Telegram или браузер: где управлять Capybara VPN в России';
const description =
  'Telegram в России заблокирован — без VPN мессенджер не откроется. Браузерная версия Capybara VPN — прямой вход в тот же сервис: подписка, тарифы и локации общие.';
const ogImage = '/og/telegram-ili-brauzer.jpg';

const canonicalPath = '/telegram-ili-brauzer/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/telegram-ili-brauzer/`,
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  datePublished: '2026-10-21',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Telegram или браузер', item: `${site.siteUrl}/telegram-ili-brauzer/` },
  ],
};

const faqs = [
  {
    q: 'Это два разных сервиса?',
    a: 'Нет. Браузерная версия и Telegram-бот — два входа в один сервис: подписка, тарифы, локации и устройства общие. Можно начать в браузере, а позже открыть бота, когда появится доступ к мессенджеру, и наоборот.',
  },
  {
    q: 'Что удобнее на компьютере?',
    a: 'Браузерная версия: в привычном окне видно всю информацию о подписке и устройствах, там же оплата и докупка слотов.',
  },
  {
    q: 'Что удобнее на телефоне?',
    a: 'В России — браузерная версия: Telegram заблокирован и без VPN не открывается. Браузер работает как обычный сайт: выбираете устройство, получаете ссылку для VPN-клиента, включаете соединение. Бот — вариант для тех, у кого доступ к Telegram уже есть.',
  },
  {
    q: 'Что делать, если Telegram не открывается?',
    a: 'В России Telegram заблокирован: без работающего VPN мессенджер не откроется. Ставить VPN ради входа в сервис не нужно — пользуйтесь браузерной версией: это тот же сервис с той же подпиской, тарифами и локациями, всё настраивается и оплачивается там.',
  },
  {
    q: 'Нужно ли устанавливать приложение?',
    a: 'Нет. Ни бота, ни отдельной программы ставить не нужно: бот работает внутри Telegram, а браузерная версия — в обычном браузере.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Telegram или браузер"
  eyebrow="Гид · Управление"
  heading="Telegram или браузер: два входа в один сервис"
  lead="В России Telegram заблокирован, поэтому основной вход — браузер: он открывается как обычный сайт. Бот — для тех, у кого доступ к мессенджеру уже есть. Подписка одна и та же."
  guidePath="/telegram-ili-brauzer/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Основы"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Telegram в России заблокирован — без VPN он не открывается, поэтому основной вход в Capybara VPN — браузерная версия: та же подписка, тарифы и локации. Бот подойдёт, когда доступ к Telegram уже есть."
  faqs={faqs}
>
  <h2>Два входа в один сервис</h2>
  <p>
    На главной две кнопки: <strong>«Продолжить в браузере»</strong> и
    <strong>«Открыть в Telegram»</strong>. Это не разные продукты и не разные
    подписки: тариф, локации, устройства и оплата у них общие. Разница — в
    доступности: в России Telegram заблокирован, поэтому основной путь —
    браузер.
  </p>

  <h2>Почему браузер — основной вход</h2>
  <p>
    Telegram в России заблокирован: без работающего VPN мессенджер не
    откроется. А ставить VPN ради того, чтобы попасть в VPN-сервис, —
    бессмысленный круг. Браузерная версия разрывает его: она открывается как
    обычный сайт — без мессенджеров и лишних шагов.
  </p>
  <p>
    Внутри всё то же самое: выбираете устройство, получаете готовую ссылку для
    VPN-клиента, выбираете локацию и включаете соединение. Первый день
    бесплатный — 10 ГБ без карты.
  </p>

  <h2>Когда Telegram подойдёт</h2>
  <ul>
    <li>Доступ к мессенджеру уже есть: Capybara настроена на другом устройстве или вы за пределами России.</li>
    <li>Удобны пара касаний и поддержка в том же окне, где подключение.</li>
    <li>Нужны уведомления бота о подписке.</li>
  </ul>

  <h2>Что умеет браузерная версия</h2>
  <ul>
    <li>Вся подписка в одном окне: тарифы, оплата, дополнительные слоты, таймер.</li>
    <li>Выдаёт готовую ссылку для VPN-клиента — вручную ничего настраивать не нужно.</li>
    <li>Работает как обычный сайт: открыли — пользуетесь, мессенджер не требуется.</li>
    <li>Аккаунт общий с ботом: начнёте в браузере, продолжите в Telegram, когда он откроется.</li>
  </ul>

  <h2>Можно ли совмещать</h2>
  <p>
    Да. Подписка привязана к аккаунту, а не к способу входа: оплатили в
    браузере на компьютере — увидите ту же подписку и в боте, когда появится
    доступ к мессенджеру. Переподключаться при переходе между входами не нужно.
  </p>

  <h2>Что с этим делать в тарифе</h2>
  <p>
    Выбор способа входа никак не влияет на тариф: безлимитный трафик и одна
    активная подписка в обоих случаях. Сравнение тарифов — на странице
    <a href={`${b}/tarify/`}>про тарифы</a>.
  </p>

  <blockquote>
    Подключение в обоих случаях одинаковое: выбрали устройство, получили
    ссылку для VPN-клиента, выбрали локацию из 38 и включили соединение.
    Пошагово — в гайде <a href={`${b}/dlya-novichkov/`}>для новичков</a>.
  </blockquote>
</GuideLayout>
