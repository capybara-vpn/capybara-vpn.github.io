---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Telegram или браузер: где удобнее управлять Capybara VPN';
const description =
  'У Capybara VPN два входа: Telegram-бот и браузерная версия. Разбираем, что удобнее на телефоне и на компьютере и можно ли их совмещать.';
const ogImage = '/og/telegram-ili-brauzer.jpg';

const canonicalPath = '/telegram-ili-brauzer/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/telegram-ili-brauzer/`,
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  datePublished: '2026-10-21',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Telegram или браузер', item: `${site.siteUrl}/telegram-ili-brauzer/` },
  ],
};

const faqs = [
  {
    q: 'Это два разных сервиса?',
    a: 'Нет. Это два входа в один сервис: тариф, подписка, локации и устройства общие. Можно начать в Telegram, а управлять в браузере и наоборот.',
  },
  {
    q: 'Что удобнее на компьютере?',
    a: 'Браузерная версия: на компьютере удобнее работать в привычном окне браузера, где видно всю информацию о подписке и устройствах.',
  },
  {
    q: 'Что удобнее на телефоне?',
    a: 'Telegram-бот: подключение занимает пару касаний, и не нужно ничего устанавливать. Ссылка всё равно попадает в VPN-клиент на устройстве — то есть работает как обычное VPN-подключение.',
  },
  {
    q: 'Что делать, если Telegram не открывается?',
    a: 'Telegram в России заблокирован РКН, поэтому открыть мессенджер из некоторых сетей не получится. Пользуйтесь браузерной версией: это тот же сервис с той же подпиской, тарифами и локациями. Всё настраивается и оплачивается там.',
  },
  {
    q: 'Нужно ли устанавливать приложение?',
    a: 'Нет. Ни бота, ни отдельной программы ставить не нужно: бот работает внутри Telegram, а браузерная версия — в обычном браузере.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Telegram или браузер"
  eyebrow="Гид · Управление"
  heading="Telegram или браузер: два входа в один сервис"
  lead="На сайте две кнопки, и обе ведут в один и тот же сервис. Разбираемся, где удобнее и как совмещать."
  guidePath="/telegram-ili-brauzer/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Основы"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Telegram-бот и браузерная версия — два входа в один сервис: подписка, тарифы и локации общие, выбирайте удобный."
  faqs={faqs}
>
  <h2>Что это за два входа</h2>
  <p>
    На главной две кнопки: <strong>«Открыть в Telegram»</strong> и
    <strong>«Продолжить в браузере»</strong>. Это не разные продукты и не разные
    подписки: тариф, локации, устройства и оплата у них общие. Разница только в
    том, где вы видите интерфейс.
  </p>

  <h2>Когда удобнее Telegram</h2>
  <ul>
    <li>Вы уже в мессенджере — подключение в пару касаний.</li>
    <li>Вы на телефоне и не хотите ничего устанавливать.</li>
    <li>Вы хотите получать поддержку в том же окне, где и подключение.</li>
  </ul>

  <h2>Когда удобнее браузер</h2>
  <ul>
    <li>Вы на компьютере: в окне браузера видно всю информацию о подписке и устройствах.</li>
    <li>Вам нужно оплатить или докупить слот — в браузере это удобнее.</li>
    <li>Вы предпочитаете не светить всё в мессенджере.</li>
    <li>
      <strong>Telegram в России заблокирован РКН.</strong> Если мессенджер не
      открывается, пользуйтесь браузерной версией: это тот же сервис с той же
      подпиской, тарифами и локациями — всё настраивается и оплачивается там.
    </li>
  </ul>

  <h2>Можно ли совмещать</h2>
  <p>
    Да. Подписка привязана к аккаунту, а не к способу входа: оплатили с
    телефона в Telegram — на компьютере в браузере увидите ту же подписку.
    Переподключаться заново при этом не нужно.
  </p>

  <h2>Что с этим делать в тарифе</h2>
  <p>
    Выбор способа входа никак не влияет на тариф: безлимитный трафик и одна
    активная подписка в обоих случаях. Сравнение тарифов — на странице
    <a href={`${b}/tarify/`}>про тарифы</a>.
  </p>

  <blockquote>
    Подключение в обоих случаях одинаковое: выбрали устройство, получили
    ссылку для VPN-клиента, выбрали локацию из 38 и включили соединение. Пошагово — в гайде
    <a href={`${b}/dlya-novichkov/`}>для новичков</a>.
  </blockquote>
</GuideLayout>
