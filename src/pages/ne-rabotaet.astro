---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';

const title = 'Capybara VPN не подключается: 7 причин и что делать';
const description =
  'Capybara VPN не подключается или не работает: 7 причин от простых к сложным — состояние соединения, конфликт клиентов, локация и сеть. Разбор по шагам.';
const ogImage = '/og/ne-rabotaet.jpg';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/ne-rabotaet/`,
  datePublished: '2026-10-21',
  dateModified: '2026-10-21',
  totalTime: 'PT5M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'RUB', value: '0' },
  step: [
    { '@type': 'HowToStep', name: 'Проверьте состояние', text: 'Убедитесь, что соединение включено, а не просто установлено.' },
    { '@type': 'HowToStep', name: 'Переподключите', text: 'Выключите и включите соединение заново.' },
    { '@type': 'HowToStep', name: 'Смените локацию', text: 'Их 38 — попробуйте соседнюю.' },
    { '@type': 'HowToStep', name: 'Отключите конфликтующее', text: 'Другой VPN-клиент, прокси или корпоративный профиль.' },
    { '@type': 'HowToStep', name: 'Смените сеть', text: 'Проверьте на мобильном интернете, если в Wi-Fi что-то режется.' },
  ],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Не работает', item: `${site.siteUrl}/ne-rabotaet/` },
  ],
};

const faqs = [
  {
    q: 'Почему не открываются сайты, хотя VPN включён?',
    a: 'Чаще всего выбрана перегруженная локация. Переключитесь на другую — это занимает секунду и решает проблему в большинстве случаев.',
  },
  {
    q: 'Включился VPN, но скорость упала. Почему?',
    a: 'Так бывает, когда сервер перегружен или маршрут неудачный. Помогает смена локации. Если падает скорость сильно и на всех локациях — проверьте, не включено ли ещё что-то, что перехватывает трафик.',
  },
  {
    q: 'Это вопрос по оплате или по подключению?',
    a: 'Поддержка работает через Telegram и отвечает по конкретной ситуации: устройство, система, локация, что именно происходит. Пришлите эти детали — разберутся быстрее.',
  },
  {
    q: 'Что делать, если ничего не помогло?',
    a: 'Напишите в поддержку и опишите шаги, которые вы уже проверили. Так вы не будете повторять то, что уже сделали, и ответ будет точнее.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath="/ne-rabotaet/"
  crumbName="Не подключается"
  eyebrow="Гид · Capybara VPN"
  heading="Capybara VPN не подключается: 7 причин и что делать"
  lead="Семь шагов от простых к сложным. В девяти случаях из десяти помогает уже первый — переключение локации."
  guidePath="/ne-rabotaet/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Проблемы"
  datePublished="2026-10-21"
  dateModified="2026-10-21"
  ogImage={ogImage}
  summary="Если Capybara VPN не подключается: проверьте состояние соединения, переподключитесь, смените локацию из 38, уберите конфликтующие VPN-клиенты и смените сеть."
  faqs={faqs}
>
  <h2>Шаг 1. Проверьте, что соединение включено</h2>
  <p>
    Самая частая причина «не работает» — профиль установлен, но переключатель
    в системе выключен. В этом случае трафик идёт напрямую, и кажется, что
    ничего не изменилось. Откройте настройки VPN на устройстве и убедитесь, что
    соединение включено.
  </p>

  <h2>Шаг 2. Переподключитесь</h2>
  <p>
    Выключите соединение и включите заново. Это помогает после долгого простоя,
    сна ноутбука или смены сети — соединение иногда «залипает» и не поднимается
    само.
  </p>

  <h2>Шаг 3. Смените локацию</h2>
  <p>
    Их <strong>38</strong>, и это решает большинство проблем: перегруженный
    сервер, неудачный маршрут, временные просадки. Выбрали другую локацию и
    включили соединение — проверяете на своём обычном сайте.
  </p>

  <h2>Шаг 4. Уберите то, что мешает</h2>
  <ul>
    <li>Другой VPN-клиент или корпоративный профиль — выключите.</li>
    <li>Прокси в системе или расширение браузера — отключите.</li>
    <li>Антивирус с фильтрацией сети — он иногда блокирует незнакомые подключения.</li>
  </ul>

  <h2>Шаг 5. Проверьте на другой сети</h2>
  <p>
    Переключитесь с домашнего Wi-Fi на мобильный интернет (или наоборот).
    Если в одной сети не работает, а в другой работает — дело в фильтрации этой
    сети: офисные и общественные сети часто режут нестандартные подключения.
  </p>

  <h2>Шаг 6. Переустановите профиль</h2>
  <p>
    Если профиль ставился давно или обновлялся сервис, его стоит пересоздать:
    пройдите инструкцию заново в боте или в браузерной версии. Это безопасно и
    занимает минуту.
  </p>

  <h2>Шаг 7. Напишите в поддержку</h2>
  <p>
    Поддержка работает через Telegram. Опишите: устройство и система, выбранная
    локация, что именно происходит и какие шаги вы уже проверили. С таким
    описанием ответ приходит быстрее всего.
  </p>

  <blockquote>
    Проверить, что сервис вообще работает, можно на бесплатном дне: 10 ГБ
    без карты. Если и на нём есть проблемы — опишите их в поддержку, разберёмся.
  </blockquote>
</GuideLayout>
