---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Первый раз с VPN: пошагово от выбора тарифа до первого соединения';
const description =
  'Впервые подключаете VPN? Полный путь за один раз: как выбрать тариф, забрать бесплатный день, подключиться и понять, что всё работает.';
const ogImage = '/og/dlya-novichkov.jpg';

const canonicalPath = '/dlya-novichkov/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/dlya-novichkov/`,
  datePublished: '2026-10-21',
  dateModified: modified,
  totalTime: 'PT10M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'RUB', value: '0' },
  step: [
    { '@type': 'HowToStep', name: 'Заберите бесплатный день', text: '10 ГБ трафика без карты: проверьте сервис до оплаты.' },
    { '@type': 'HowToStep', name: 'Выберите устройство', text: 'Укажите, с чего будете подключаться: телефон, компьютер или роутер.' },
    { '@type': 'HowToStep', name: 'Включите соединение', text: 'Выберите локацию из 38 и включите соединение.' },
    { '@type': 'HowToStep', name: 'Проверьте результат', text: 'Откройте видео и загрузите файл — убедитесь, что всё быстро.' },
  ],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Для новичков', item: `${site.siteUrl}/dlya-novichkov/` },
  ],
};

const faqs = [
  {
    q: 'Я никогда не пользовался VPN — справлюсь?',
    a: 'Да. Вам не нужно разбираться в протоколах и настройках: вы выбираете устройство, получаете готовый профиль и включаете соединение. Дальше работает как обычный интернет.',
  },
  {
    q: 'С чего начать — с тарифа или с бесплатного дня?',
    a: 'С бесплатного дня: 10 ГБ без карты дают понять, подходит ли сервис, и только потом вы решаете про оплату. Ничего не теряете, если он не подошёл.',
  },
  {
    q: 'Что делать, если я не понимаю, работает ли VPN?',
    a: 'Откройте любой сайт, включите и выключите соединение и сравните. Разница в скорости загрузки — самый простой тест. Подробнее в гайде про проверку скорости.',
  },
  {
    q: 'Нужно ли что-то устанавливать?',
    a: 'Нет. Всё настраивается прямо в браузере или через Telegram-бот, без установки программ и без поиска конфигов по сторонним сайтам.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Для новичков"
  eyebrow="Гид · С чего начать"
  heading="Первый раз с VPN: от тарифа до первого соединения"
  lead="Если вы ещё ни разу не подключались — вот весь путь целиком, без терминов и лишних шагов. С проверкой на бесплатном дне."
  guidePath="/dlya-novichkov/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Инструкции"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Первый раз с VPN проще, чем кажется: заберите бесплатный день, выберите устройство, включите локацию — всё остальное сервис сделает сам."
  faqs={faqs}
>
  <h2>Шаг 0. Не начинайте с оплаты</h2>
  <p>
    Прежде чем платить, заберите бесплатный день: 10 ГБ трафика, карта не
    нужна. Этого хватает, чтобы попробовать сервис на своих устройствах и
    убедиться, что он вам подходит. Подробности — в гайде
    <a href={`${b}/probny-den/`}>про бесплатный день</a>.
  </p>

  <h2>Шаг 1. Откройте сервис</h2>
  <p>
    Зайдите на <a href={`${b}/`}>сайт Capybara VPN</a>. Дальше нажмите
    <strong>«Открыть в Telegram»</strong> или <strong>«Продолжить в браузере»</strong>
    — неважно, что выбрать, это два входа в один сервис. Инструкция внутри
    одинаковая.
  </p>

  <h2>Шаг 2. Скажите, откуда подключаетесь</h2>
  <p>
    Выберите устройство: телефон, компьютер или роутер. Сервис выдаст
    готовый профиль — вам не нужно ничего скачивать со сторонних сайтов и
    ничего не настраивать вручную. Инструкция по каждой платформе: iOS,
    Android, Windows, macOS, Linux, TV и роутер.
  </p>

  <h2>Шаг 3. Включите соединение</h2>
  <p>
    Выберите локацию из 38 и включите соединение. Всё, дальше интернет
    работает как обычно, только через выбранный сервер.
  </p>

  <h2>Шаг 4. Проверьте, что всё работает</h2>
  <p>
    Откройте видео и загрузите файл: с VPN должно быть быстрее, чем без него.
    Если разницы нет или что-то тормозит — переключите локацию, их 38. Как
    правильно мерить — в гайде <a href={`${b}/proverka-skorosti/`}>про скорость</a>.
  </p>

  <h2>Шаг 5. Решите, нужен ли тариф</h2>
  <p>
    Если понравилось — выберите тариф: 30 дней за 249 ₽, 90 дней за 672 ₽ или
    180 дней за 1195 ₽. Во всех безлимитный трафик на 1 устройство. Сравнение
    — на странице <a href={`${b}/tarify/`}>про тарифы</a>, оплата — в гайде
    <a href={`${b}/oplata/`}>про оплату</a>.
  </p>

  <blockquote>
    Если что-то пошло не так, почти всегда помогает переключение локации или
    переподключение профиля. Подробный разбор — в гайде
    <a href={`${b}/ne-rabotaet/`}>что делать, если не работает</a>.
  </blockquote>
</GuideLayout>
