---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';

const title = 'Capybara VPN на iOS: настройка на iPhone и iPad за 5 минут';
const description =
  'Как подключить Capybara VPN на iPhone и iPad: 4 шага, 5 минут, первый день бесплатно. Тарифы от 249 ₽.';
const host = new URL(site.siteUrl).hostname;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  image: `${site.siteUrl}/og/og-image.jpg`,
  mainEntityOfPage: `${site.siteUrl}/ios/`,
  datePublished: '2026-09-29',
  dateModified: '2026-10-06',
  totalTime: 'PT5M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'RUB', value: '249' },
  step: [
    { '@type': 'HowToStep', name: 'Откройте сайт', text: `Откройте ${host} в Safari.` },
    { '@type': 'HowToStep', name: 'Выберите вход', text: 'Нажмите «Открыть в Telegram» или «Открыть в браузере».' },
    { '@type': 'HowToStep', name: 'Заберите пробный период', text: 'Выберите iOS: 1 день бесплатно, карта не нужна.' },
    { '@type': 'HowToStep', name: 'Подключитесь', text: 'Следуйте инструкции, выберите локацию и включите соединение.' },
  ],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'iOS', item: `${site.siteUrl}/ios/` },
  ],
};
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath="/ios/"
  crumbName="iOS"
  eyebrow="Гид · iOS"
  heading="Capybara VPN на iPhone и iPad за 5 минут"
  lead="Настройка, с которой справится даже тот, кто «не дружит с техникой»: четыре шага, первый день бесплатно, карта не нужна."
  guidePath="/ios/"
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Инструкции"
  datePublished="2026-09-29"
  dateModified="2026-10-06"
>
          <h2>Шаг 1. Откройте сайт сервиса</h2>
          <p>
            Перейдите на <a href={`${b}/`}>сайт Capybara VPN</a> в Safari.
            Ничего скачивать заранее не нужно.
          </p>

          <h2>Шаг 2. Выберите, где начать</h2>
          <p>
            Две кнопки: <strong>«Открыть в Telegram»</strong> — если удобен мессенджер,
            и <strong>«Открыть в браузере»</strong> — если проще без него.
            Оба пути ведут к одной подписке.
          </p>

          <h2>Шаг 3. Заберите пробный период</h2>
          <p>
            Выберите устройство <strong>iOS</strong>: первый день — бесплатно,
            вы получаете 10 ГБ трафика на тест. Следуйте короткой инструкции —
            профиль установится сам.
          </p>

          <h2>Шаг 4. Включите и проверьте</h2>
          <p>
            Выберите локацию из 38 и включите соединение. Проверьте скорость на видео
            и звонках — так вы сразу почувствуете разницу.
          </p>

          <blockquote>
            Понравилось — выбирайте тариф: 30 дней за 249 ₽, 90 дней за 672 ₽
            или 180 дней за 1195 ₽. Вопросы — в поддержку через Telegram.
          </blockquote>
</GuideLayout>
