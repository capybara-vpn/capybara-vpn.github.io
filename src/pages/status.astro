---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { lastModifiedDate } from '../lib/dates';

const title = 'Статус серверов Capybara VPN — живая проверка';
const description =
  'Статус серверов Capybara VPN: проверка доступности локаций из вашего браузера. Нидерланды, Германия, США, Япония и другие локации — отклик и доступность порта в реальном времени.';
const ogImage = '/og/og-image.jpg';

const canonicalPath = '/status/';
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/status/`,
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  datePublished: '2026-11-12',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Статус серверов', item: `${site.siteUrl}/status/` },
  ],
};

type Server = { flag: string; name: string; host: string; proto: string; speed: string };
const mainServers: Server[] = [
  { flag: '🇳🇱', name: 'Нидерланды', host: 'nl.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇱🇹', name: 'Литва', host: 'lt.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇪🇪', name: 'Эстония', host: 'ee.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇫🇮', name: 'Финляндия', host: 'fi.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇸🇪', name: 'Швеция', host: 'se.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇵🇱', name: 'Польша', host: 'pl.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇩🇪', name: 'Германия', host: 'de.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇫🇷', name: 'Франция', host: 'fr.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇺🇸', name: 'США', host: 'us.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇯🇵', name: 'Япония', host: 'jp.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇸🇬', name: 'Сингапур', host: 'sg.dertux.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇷🇺', name: 'Россия', host: 'ru.moordox.com', proto: 'VLESS Reality', speed: '10 Гбит/с' },
  { flag: '🇧🇾', name: 'Беларусь', host: 'by.moordox.com', proto: 'VLESS Reality', speed: '1 Гбит/с' },
  { flag: '🇰🇿', name: 'Казахстан', host: 'kz.moordox.com', proto: 'VLESS Reality', speed: '1 Гбит/с' },
  { flag: '🛟', name: 'Франция — запасная', host: 'fr-tls.moordox.com', proto: 'VLESS TLS', speed: '10 Гбит/с' },
];
const gameServers: Server[] = [
  { flag: '🎮', name: 'Германия — игровой', host: 'deh2.moordox.com', proto: 'Hysteria2 · QUIC', speed: '10 Гбит/с' },
  { flag: '🎮', name: 'Нидерланды — игровой', host: 'nlh2.moordox.com', proto: 'Hysteria2 · QUIC', speed: '10 Гбит/с' },
];
const autoCount = 11;
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Статус серверов"
  eyebrow="Инструмент"
  heading="Статус серверов"
  lead="Живая проверка доступности локаций прямо из вашего браузера: нажмите «Проверить сейчас» — страница постучится на каждый сервер и покажет отклик. Проверка не требует подписки."
  guidePath={canonicalPath}
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Инструменты"
  datePublished="2026-11-12"
  dateModified={modified}
  ogImage={ogImage}
  ogType="website"
>
  <div id="status-root" class="not-prose">
    <!-- summary strip -->
    <div class="card spot relative overflow-hidden p-6 sm:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <p class="mono text-[11px] font-semibold uppercase tracking-[0.18em] text-brand">Сводка</p>
          <p id="status-summary" class="mt-2 text-[17px] font-semibold text-ink">
            Нажмите «Проверить сейчас» — опросим {mainServers.length} локаций
          </p>
          <p id="status-time" class="mono mt-1.5 text-[12.5px] text-ink-3">Последняя проверка: —</p>
        </div>
        <button
          id="status-run"
          type="button"
          class="btn btn-primary shrink-0 px-6 py-3.5 text-[15px]"
        >
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 3v6h-6"></path></svg>
          <span id="status-run-label">Проверить сейчас</span>
        </button>
      </div>
      <div class="mt-6 grid grid-cols-3 gap-2 sm:gap-3" role="presentation">
        <div class="hairline rounded-2xl bg-surface-2/70 px-1 py-3.5 text-center sm:px-3">
          <p id="count-ok" class="display text-[24px] text-ink sm:text-[26px]">—</p>
          <p class="mt-1 whitespace-nowrap text-[10px] uppercase tracking-[0.06em] text-ink-3 sm:text-[11px] sm:tracking-[0.1em]">отвечают</p>
        </div>
        <div class="hairline rounded-2xl bg-surface-2/70 px-1 py-3.5 text-center sm:px-3">
          <p id="count-fail" class="display text-[24px] text-ink sm:text-[26px]">—</p>
          <p class="mt-1 whitespace-nowrap text-[10px] uppercase tracking-[0.06em] text-ink-3 sm:text-[11px] sm:tracking-[0.1em]">не отвечают</p>
        </div>
        <div class="hairline rounded-2xl bg-surface-2/70 px-1 py-3.5 text-center sm:px-3">
          <p class="display text-[24px] text-ink sm:text-[26px]">{mainServers.length + gameServers.length + autoCount}</p>
          <p class="mt-1 whitespace-nowrap text-[10px] uppercase tracking-[0.06em] text-ink-3 sm:text-[11px] sm:tracking-[0.1em]">всего</p>
        </div>
      </div>
    </div>

    <!-- main list -->
    <h2 class="mt-12 text-[24px] font-bold tracking-[-0.02em] text-ink">Основные локации</h2>
    <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-2">
      Проверка стучится на порт сервера и замеряет время ответа: соединение
      прогревается, затем делается два замера — показывается лучший, чтобы
      исключить помехи первого подключения. Значение — оценка из вашего
      браузера, а не замер скорости.
    </p>
    <!-- legend -->
    <div class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[13px] text-ink-2">
      <span class="inline-flex items-center gap-2">
        <span class="status-dot status-dot-ok"></span>
        работает, отклик нормальный
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="status-dot status-dot-slow"></span>
        работает, отклик высокий
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="status-dot status-dot-fail"></span>
        сервер не отвечает
      </span>
    </div>
    <div id="status-grid" class="card mt-5 overflow-hidden !rounded-3xl">
      <div class="mono hidden grid-cols-[1.3fr_1.2fr_auto] gap-4 border-b border-line px-6 py-3.5 text-[10.5px] font-semibold uppercase tracking-[0.14em] text-ink-3 sm:grid">
        <span>Локация</span>
        <span>Протокол</span>
        <span class="text-right">Отклик</span>
      </div>
      {
        mainServers.map((s) => (
          <div
            class="status-row flex items-center gap-3.5 border-b border-line px-4 py-3.5 transition-colors last:border-b-0 hover:bg-surface-2/60 sm:grid sm:grid-cols-[1.3fr_1.2fr_auto] sm:items-center sm:gap-4 sm:px-6"
            data-probe={s.host}
          >
            <div class="flex min-w-0 items-center gap-3">
              <span class="text-[22px] leading-none" aria-hidden="true">{s.flag}</span>
              <span class="min-w-0">
                <span class="block text-[15px] font-semibold leading-snug tracking-tight text-ink">{s.name}</span>
                <span class="mono block text-[11.5px] leading-snug text-ink-3 sm:hidden">{s.speed}</span>
              </span>
            </div>
            <span class="hidden min-w-0 text-[13px] text-ink-2 sm:block">{s.proto} · {s.speed}</span>
            <div class="ml-auto flex shrink-0 items-center justify-end gap-2.5 sm:ml-0">
              <span class="status-dot" data-dot></span>
              <span class="mono min-w-[86px] text-right text-[12.5px] font-medium text-ink-2" data-result>не проверено</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- game servers -->
    <h2 class="mt-12 text-[24px] font-bold tracking-[-0.02em] text-ink">Игровые серверы</h2>
    <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-2">
      Работают по протоколу Hysteria2 поверх QUIC — браузерная проверка порта для них не показательна, поэтому статус показывает дежурное состояние.
    </p>
    <div class="card mt-5 overflow-hidden !rounded-3xl">
      {
        gameServers.map((s) => (
          <div class="flex items-center gap-3.5 border-b border-line px-4 py-3.5 last:border-b-0 sm:grid sm:grid-cols-[1.3fr_1.2fr_auto] sm:items-center sm:gap-4 sm:px-6">
            <div class="flex min-w-0 items-center gap-3">
              <span class="text-[22px] leading-none" aria-hidden="true">{s.flag}</span>
              <span class="min-w-0">
                <span class="block text-[15px] font-semibold leading-snug tracking-tight text-ink">{s.name}</span>
                <span class="mono block text-[11.5px] leading-snug text-ink-3 sm:hidden">{s.speed}</span>
              </span>
            </div>
            <span class="hidden min-w-0 text-[13px] text-ink-2 sm:block">{s.proto} · {s.speed}</span>
            <div class="ml-auto flex shrink-0 items-center justify-end gap-2.5 sm:ml-0">
              <span class="status-dot status-dot-idle" title="QUIC-сервер не пингуется из браузера"></span>
              <span class="mono min-w-[86px] text-right text-[12.5px] font-medium text-ink-2">в работе</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- auto-bypass summary -->
    <div class="card spot mt-10 flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:gap-4">
      <span class="text-[24px] leading-none" aria-hidden="true">⚡</span>
      <p class="min-w-0 flex-1 text-[14.5px] leading-relaxed text-ink-2">
        <strong class="font-semibold text-ink">Авто-обход</strong> — {autoCount} точек
        подключения с автоматическим выбором рабочей. Клиент переключает их
        самостоятельно, отдельная проверка не нужна: если одна точка замолчала,
        подписка перейдёт на следующую.
      </p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var cards = document.querySelectorAll('#status-grid [data-probe]');
      var btn = document.getElementById('status-run');
      var label = document.getElementById('status-run-label');
      var summary = document.getElementById('status-summary');
      var timeEl = document.getElementById('status-time');
      var okEl = document.getElementById('count-ok');
      var failEl = document.getElementById('count-fail');
      var TIMEOUT = 4500;
      var running = false;

      var CLASSES = {
        idle: 'status-dot status-dot-idle',
        check: 'status-dot status-dot-check',
        ok: 'status-dot status-dot-ok',
        slow: 'status-dot status-dot-slow',
        fail: 'status-dot status-dot-fail'
      };
      var SLOW_MS = 300;

      function setState(card, state, text) {
        var dot = card.querySelector('[data-dot]');
        var out = card.querySelector('[data-result]');
        if (dot) dot.className = CLASSES[state];
        if (out) out.textContent = text;
      }

      function probeOnce(host) {
        return new Promise(function (resolve) {
          var url = 'https://' + host + '/status-check-' + Date.now() + '-' + Math.floor(Math.random() * 1e6);
          var t0 = performance.now();
          var done = false;
          var ctrl = typeof AbortController === 'function' ? new AbortController() : null;
          var timer = setTimeout(function () {
            if (done) return;
            done = true;
            if (ctrl) ctrl.abort();
            resolve({ ok: false, ms: TIMEOUT });
          }, TIMEOUT);
          fetch(url, { mode: 'no-cors', cache: 'no-store', signal: ctrl ? ctrl.signal : undefined })
            .catch(function () {})
            .then(function () {
              if (done) return;
              done = true;
              clearTimeout(timer);
              resolve({ ok: true, ms: Math.round(performance.now() - t0) });
            });
        });
      }

      /* Methodology: the first request to a host includes DNS + TCP + TLS
         setup and swings wildly between runs; Reality proxies serve each
         request over a fresh connection, so there is no keep-alive to lean
         on. So: warm-up request (discarded), then three measured ones —
         the smallest of the three is the cleanest estimate of the response
         time, repeatable across runs. */
      async function probe(host) {
        var warm = await probeOnce(host);
        if (warm.ok) {
          var m1 = await probeOnce(host);
          var m2 = await probeOnce(host);
          var m3 = await probeOnce(host);
          if (m1.ok || m2.ok || m3.ok) {
            return { ok: true, ms: Math.min(m1.ms, m2.ms, m3.ms) };
          }
        }
        // one retry cycle before declaring the server down
        var warm2 = await probeOnce(host);
        if (warm2.ok) {
          var m1b = await probeOnce(host);
          var m2b = await probeOnce(host);
          var m3b = await probeOnce(host);
          if (m1b.ok || m2b.ok || m3b.ok) {
            return { ok: true, ms: Math.min(m1b.ms, m2b.ms, m3b.ms) };
          }
        }
        return { ok: false, ms: TIMEOUT };
      }

      function run() {
        if (running) return;
        running = true;
        btn.disabled = true;
        label.textContent = 'Проверяю…';
        okEl.textContent = '—';
        failEl.textContent = '—';
        var tasks = [];
        cards.forEach(function (card) {
          var host = card.getAttribute('data-probe');
          setState(card, 'check', 'проверяю…');
          tasks.push(probe(host).then(function (r) {
            if (!r.ok) {
              setState(card, 'fail', 'не отвечает');
              return 0;
            }
            if (r.ms > SLOW_MS) {
              setState(card, 'slow', '~' + r.ms + ' мс');
            } else {
              setState(card, 'ok', '~' + r.ms + ' мс');
            }
            return 1;
          }));
        });
        Promise.all(tasks).then(function (results) {
          var ok = results.filter(Boolean).length;
          var fail = results.length - ok;
          okEl.textContent = String(ok);
          failEl.textContent = String(fail);
          summary.textContent = ok === results.length
            ? 'Все ' + results.length + ' локаций отвечают'
            : 'Отвечают ' + ok + ' из ' + results.length + ' локаций';
          timeEl.textContent = 'Последняя проверка: ' +
            new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
          btn.disabled = false;
          label.textContent = 'Проверить снова';
          running = false;
        });
      }

      btn.addEventListener('click', run);
      setTimeout(run, 400);
    })();
  </script>
</GuideLayout>

<style>
  /* neutralize .guide-body typography inside the tool area */
  #status-root h2, #status-root h3, #status-root p { margin-top: 0 !important; }
  #status-root { margin-top: 2.5rem; }
</style>
