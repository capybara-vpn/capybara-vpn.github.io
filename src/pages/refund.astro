---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Возврат средств Capybara VPN: правила и как оформить';
const description =
  'Возврат Capybara VPN: когда возможен, что считается использованием и как оформить запрос через поддержку. Полные правила — в условиях пользования сервисом.';
const ogImage = '/og/og-image.jpg';

const canonicalPath = '/refund/';
const modified = lastModifiedDate(canonicalPath);
const officialTerms = 'https://capybara.black/terms';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/refund/`,
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  datePublished: '2026-11-11',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Возврат', item: `${site.siteUrl}/refund/` },
  ],
};

const faqs = [
  {
    q: 'Что считается использованием сервиса?',
    a: 'Любой сгенерированный трафик: как только через сервис прошёл 1 МБ и больше, услуга считается оказанной в полном объёме, и возврат невозможен. Меньше 1 МБ — запрос рассматривается индивидуально.',
  },
  {
    q: 'Возвращаются ли комиссии платёжных систем?',
    a: 'Нет: комиссии банков и платёжных провайдеров не возвращаются ни в каком случае — вернётся только сумма тарифа.',
  },
  {
    q: 'Куда отправлять запрос на возврат?',
    a: 'В поддержку в Telegram, приложив номер платежа и краткое описание ситуации. Если трафика ещё не было, запрос рассматривают в первую очередь.',
  },
  {
    q: 'Можно ли вернуть деньги за пробный день?',
    a: 'Пробный день бесплатный и оформляется без карты — возвращать нечего. Он и существует, чтобы проверить сервис до оплаты.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Возврат"
  eyebrow="Документы"
  heading="Возврат средств"
  lead="Возврат возможен только до фактического использования сервиса. Ниже — что это значит на практике и как оформить запрос."
  guidePath={canonicalPath}
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Документы"
  datePublished="2026-11-11"
  dateModified={modified}
  ogImage={ogImage}
  ogType="website"
  summary="Возврат возможен только до фактического использования: если через сервис прошёл трафик от 1 МБ, услуга считается оказанной в полном объёме, и возврат невозможен. Комиссии платёжных систем не возвращаются. Запрос — в поддержку с номером платежа."
  faqs={faqs}
>
  <h2>Когда возврат возможен</h2>
  <p>
    Возврат возможен только при отсутствии фактического использования услуги.
    Доступ к сервису выдаётся сразу после оплаты, поэтому «окно возврата» —
    до первого трафика.
  </p>

  <h2>Что считается использованием</h2>
  <ul>
    <li>
      <strong>От 1 МБ трафика и более</strong> — услуга считается оказанной в
      полном объёме, возврат невозможен.
    </li>
    <li>
      <strong>Менее 1 МБ</strong> — запрос рассматривается индивидуально.
    </li>
    <li>
      <strong>Комиссии платёжных систем и банков</strong> не возвращаются.
    </li>
    <li>
      При выявлении злоупотребления или мошеннических действий в возврате
      может быть отказано.
    </li>
  </ul>

  <h2>Как оформить запрос</h2>
  <ol>
    <li>
      <strong>Напишите в поддержку в Telegram</strong> — там отвечают живые
      люди, ежедневно.
    </li>
    <li>
      <strong>Приложите номер платежа</strong> — по нему вашу оплату найдут
      быстрее всего.
    </li>
    <li>
      <strong>Опишите ситуацию</strong>: что произошло и когда был последний
      трафик, если он был.
    </li>
  </ol>

  <h2>Проверьте до оплаты</h2>
  <p>
    Пробный день существует именно для этого: 10 ГБ трафика бесплатно, без
    карты. Решение о покупке принимается на своих замерах, а не вслепую —
    так спор о возврате не понадобится вовсе.
  </p>

  <h2>Полный текст правил</h2>
  <p>
    Раздел о платежах и возвратах — в
    <a href={officialTerms} target="_blank" rel="noopener noreferrer">условиях пользования сервисом</a>.
    Про оплату подробнее — в гайде <a href={`${b}/oplata/`}>«Как оплатить»</a>.
  </p>

  <blockquote>
    Начните с бесплатного дня: 10 ГБ без карты. Это честнее любого возврата.
  </blockquote>
</GuideLayout>
