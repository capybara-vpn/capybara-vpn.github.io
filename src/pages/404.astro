---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL ?? '/';
const b = base.endsWith('/') ? base.slice(0, -1) : base;
---

<BaseLayout
  title="Страница не найдена — Capybara VPN"
  description="Такой страницы нет. Вернитесь на главную Capybara VPN: тарифы от 249 ₽, подключение через Telegram или браузер."
  canonicalPath="/404"
  showFaq={false}
>
  <Header />
  <main id="main" tabindex="-1" class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center px-6 text-center">
    <p class="eyebrow">404</p>
    <h1 class="display mt-4 text-5xl text-white">Такой страницы нет</h1>
    <p class="lead mt-4">Зато есть быстрый VPN от 249 ₽. Вернёмся к главному?</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={`${b}/`} class="btn btn-primary px-6 py-3.5">На главную</a>
      <a href={site.telegramUrl} class="btn btn-ghost px-6 py-3.5" target="_blank" rel="noopener noreferrer">
        Открыть в Telegram
      </a>
    </div>
  </main>
  <Footer />
  <MobileCta />
  <Consent />
</BaseLayout>
