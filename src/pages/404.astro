---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
---

<BaseLayout
  title="Страница не найдена — Capybara VPN"
  description="Такой страницы нет. Вернитесь на главную Capybara VPN: тарифы от 249 ₽, подключение через Telegram или браузер."
  canonicalPath="/"
  noindex
  showFaq={false}
>
  <Header />
  <div id="top">
  <main id="main" tabindex="-1" class="relative mx-auto flex min-h-screen min-h-dvh max-w-xl flex-col items-center justify-center px-6 py-24 text-center">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px]" aria-hidden="true">
      <div class="ambient left-1/2 top-[-160px] h-[380px] w-[min(680px,100vw)] -translate-x-1/2" style="background: var(--glow)"></div>
    </div>
    <p class="display reveal is-visible relative text-[clamp(5rem,20vw,9rem)] leading-none text-ink" aria-hidden="true">
      4<span class="grad-text">0</span>4
    </p>
    <p class="eyebrow mt-2">Ошибка</p>
    <h1 class="display mt-4 text-3xl text-ink sm:text-4xl">Такой страницы нет</h1>
    <p class="lead mt-4">Зато есть быстрый VPN от 249 ₽. Вернёмся к главному?</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={`${b}/`} class="btn btn-primary px-6 py-3.5">На главную</a>
      <a
        href={site.browserUrl}
        class="btn btn-ghost px-6 py-3.5"
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        data-cta
        data-placement="404"
        data-destination="browser"
      >
        Продолжить в браузере
      </a>
      <a
        href={site.telegramUrl}
        class="btn btn-ghost px-6 py-3.5"
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        data-cta
        data-placement="404"
        data-destination="telegram"
      >
        Открыть в Telegram
      </a>
    </div>
  </main>
  </div>
  <Footer />
  <MobileCta />
  <Consent />
</BaseLayout>
