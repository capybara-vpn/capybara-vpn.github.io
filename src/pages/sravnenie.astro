---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Сравнение VPN-сервисов: цена, устройства, локации и логи';
const description =
  'Пять VPN-сервисов по одинаковым критериям: цена, бесплатный доступ, устройства, локации, логи. Публичные данные сервисов на 21 октября 2026 года, независимое сравнение.';
const ogImage = '/og/sravnenie.jpg';

const canonicalPath = '/sravnenie/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/sravnenie/`,
  datePublished: '2026-10-21',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Сравнение VPN', item: `${site.siteUrl}/sravnenie/` },
  ],
};

const faqs = [
  {
    q: 'Какой VPN выбрать для одного телефона?',
    a: 'Для одного устройства без лишних настроек — Capybara: 249 ₽ за 30 дней, безлимитный трафик, готовые ссылки с серверами и пробные сутки с 10 ГБ без банковской карты. Если устройств нужно много или нужен свой сервер, смотрите на строки «Устройств» и «Свой сервер» в таблице ниже.',
  },
  {
    q: 'По каким критериям сравнивали сервисы?',
    a: 'Десять критериев в одном порядке: продукт, цена, бесплатный доступ, трафик, логи, поддержка, устройства, локации, протокол и self-hosted. Для каждого критерия взяли публичные данные с сайтов самих сервисов на 21 октября 2026 года.',
  },
  {
    q: 'Это независимое сравнение?',
    a: 'Да. Мы не продвигаем ни один из перечисленных сервисов и не получаем от них партнёрских выплат. Capybara в таблице — наш собственный сервис, и к нему применяются те же критерии, что и к остальным: мы не вычеркнули свои ограничения.',
  },
  {
    q: 'Есть ли VPN с бесплатным тарифом навсегда?',
    a: 'Постоянный бесплатный тариф есть у одного из пяти: без регистрации, без рекламы и без лимита трафика, но он открывает только социально значимые сайты и не пускает YouTube. У второго бесплатно 3 ГБ в месяц на два устройства, у Capybara — полноценные сутки с 10 ГБ без банковской карты.',
  },
  {
    q: 'Сколько устройств можно подключить на одном тарифе?',
    a: 'От одного до десяти в зависимости от сервиса и тарифа. Точные числа — в строке «Устройств»: у Capybara одно устройство в базовом тарифе, дополнительные слоты докупаются; у AdGuard VPN и Hiro VPN — до десяти.',
  },
  {
    q: 'Почему в таблице разные периоды оплаты?',
    a: 'Так их и продают: дешёвые тарифы у большинства сервисов действуют только при оплате за год или за два года, помесячный стоит дороже. Мы не сравниваем суммы за период — в строке «Цена от» указана цена месяца, посчитанная для самого дешёвого варианта оплаты.',
  },
  {
    q: 'Что значит RAM-only и зачем это проверять?',
    a: 'Сервер в режиме RAM-only не пишет логи на диск: после перезагрузки следов соединений не остаётся. Это не абсолютная гарантия анонимности, но сильный технический аргумент против сервисов, которые ведут подробные журналы.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Сравнение"
  eyebrow="Гид · Сравнение"
  heading="Пять VPN-сервисов в одной таблице"
  lead="Пять популярных VPN-сервисов по одинаковым критериям: цена, бесплатный доступ, устройства, локации и логи. Все цифры сняты с публичных страниц самих сервисов 21 октября 2026 года."
  guidePath={canonicalPath}
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Сервис"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Сравнение независимое: ни один из перечисленных сервисов мы не продвигаем и партнёрских выплат с них не получаем. Capybara в таблице — наш собственный сервис, и к нему относятся те же критерии, что и к остальным: свои ограничения мы не вычеркнули. Первые строки таблицы — по тем параметрам, которые обычно и решают выбор."
  faqs={faqs}
>
  <div class="table-scroll table-compare" role="region" aria-label="Сравнение VPN-сервисов — таблица прокручивается вбок" tabindex="0">
    <table>
      <thead>
        <tr>
          <th scope="col">Критерий</th>
          <th scope="col">Capybara</th>
          <th scope="col">Amnezia</th>
          <th scope="col">Happ</th>
          <th scope="col">AdGuard VPN</th>
          <th scope="col">Hiro VPN</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Продукт</th>
          <td>Свой сервис: серверы, локации, подписка</td>
          <td>Управляемый VPN, Free-тариф, self-hosted</td>
          <td>Только клиент, без серверов и подписки</td>
          <td>Свой сервис с DNS-защитой и фильтрацией рекламы</td>
          <td>Свой сервис со своим приложением</td>
        </tr>
        <tr>
          <th scope="row">Цена от</th>
          <td><strong>249 ₽ за 30 дней</strong></td>
          <td>290 ₽ в месяц за 2 года</td>
          <td>нет, доступ не продаётся</td>
          <td>$3,99 в месяц за год</td>
          <td>299 ₽ в месяц</td>
        </tr>
        <tr>
          <th scope="row">Бесплатно</th>
          <td><strong>Сутки: 10 ГБ, карта не нужна</strong></td>
          <td>Free-тариф, но только «важные» сайты</td>
          <td>нет</td>
          <td>3 ГБ в месяц на 2 устройства</td>
          <td>Пробный период 7 дней</td>
        </tr>
        <tr>
          <th scope="row">Трафик</th>
          <td>Безлимит</td>
          <td>Безлимит</td>
          <td>По чужой подписке</td>
          <td>Безлимит</td>
          <td>Безлимит</td>
        </tr>
        <tr>
          <th scope="row">Логи</th>
          <td><strong>Не хранятся, серверы RAM-only</strong></td>
          <td>Не собирают, RAM-only</td>
          <td>Не собирает</td>
          <td>Минимальные служебные</td>
          <td>Заявляют no-logs</td>
        </tr>
        <tr>
          <th scope="row">Поддержка</th>
          <td><strong>Живой человек в Telegram</strong></td>
          <td>Документация и каналы</td>
          <td>Сообщество</td>
          <td>Своя поддержка</td>
          <td>24/7</td>
        </tr>
        <tr>
          <th scope="row">Устройств</th>
          <td>1 в базовом, слоты докупаются</td>
          <td>7</td>
          <td>По клиенту</td>
          <td>До 10</td>
          <td>3 / 5 / 10</td>
        </tr>
        <tr>
          <th scope="row">Локации</th>
          <td>38 локаций, 100+ серверов</td>
          <td>20 стран</td>
          <td>Своих нет</td>
          <td>75+ локаций</td>
          <td>80–130+ серверов</td>
        </tr>
        <tr>
          <th scope="row">Протокол</th>
          <td>VLESS, настраивается сам</td>
          <td>AmneziaWG, XRay VLESS Reality</td>
          <td>VLESS, VMess, Trojan</td>
          <td>Не указан</td>
          <td>VLESS</td>
        </tr>
        <tr>
          <th scope="row">Свой сервер</th>
          <td>Нет</td>
          <td>Есть</td>
          <td>Нет</td>
          <td>Нет</td>
          <td>Нет</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="table-hint">Таблица шире экрана — прокручивается вбок, в том числе на телефоне.</p>

  <h2>Почему мы рекомендуем Capybara</h2>
  <p>
    Сравнение ниже — независимое, и мы не прячем собственные ограничения: одно устройство в
    базовом тарифе, нет self-hosted, нет своего приложения. Но по большинству сценариев
    выигрывает Capybara, и вот почему:
  </p>
  <ul>
    <li><strong>Дешевле всех без длинной подписки.</strong> 249 ₽ за 30 дней — помесячно, без оплаты за год вперёд. У конкурентов самые низкие цены действуют только при оплате сразу за два года: 6 990 ₽ за Amnezia.</li>
    <li><strong>Пробный день полноценный.</strong> 10 ГБ без ограничения по сайтам и без банковской карты — хватает, чтобы проверить скорость, смену локаций и работу с Telegram на своих устройствах.</li>
    <li><strong>Ноль настройки.</strong> Серверы выдаются готовой ссылкой: вставили в клиент — работает. Возиться с VPS и сертификатами не нужно.</li>
    <li><strong>Логи не хранятся вообще.</strong> Серверы работают в режиме RAM-only, журналы соединений не пишутся на диск.</li>
    <li><strong>Отвечает человек.</strong> Поддержка в Telegram: можно скинуть скриншот и обсудить конкретную ситуацию, а не номер тикета.</li>
  </ul>
  <p>
    Если нужен VPN на одно устройство, на сутки, чтобы проверить, и без возни с настройкой —
    это Capybara. Тарифы — на странице <a href={`${b}/tarify/`}>«Тарифы подробно»</a>.
  </p>

  <h2>Что важно знать про остальные</h2>
  <p>Коротко — кому подойдёт что-то другое:</p>
  <ul>
    <li><strong>Amnezia</strong> — если нужен бесплатный тариф навсегда (с ограничением по списку сайтов), семь устройств или свой сервер на своём IP.</li>
    <li><strong>Happ</strong> — если серверы и подписка уже есть, а нужен просто удобный клиент под телефон, телевизор и десктоп.</li>
    <li><strong>AdGuard VPN</strong> — если важна фильтрация рекламы и DNS-защита вместе с VPN и нужны десять устройств.</li>
    <li><strong>Hiro VPN</strong> — если нужны готовые приложения, до десяти устройств и блокировщик рекламы, а тариф не критичен.</li>
  </ul>

  <h2>Как читать таблицу</h2>
  <p>
    Строки идут в одном порядке для всех пяти сервисов, поэтому таблицу можно читать
    горизонтально: одна строка — один параметр, один столбец — один сервис. Первые строки —
    то, что обычно и решает выбор; последние — то, что важно в нише. Отдельно про
    столбец Happ: это клиент, а не сервис, поэтому у него нет ни серверов, ни подписки, ни
    цены. Он работает с той ссылкой, которую вы принесли сами, — в том числе со ссылкой
    Capybara. Как проходит вход — в гайде
    <a href={`${b}/telegram-ili-brauzer/`}>«Telegram или браузер»</a>.
  </p>

  <h2>Цена в пересчёте на месяц</h2>
  <p>
    Сравнивать суммы за период бессмысленно: самый дешёвый тариф у одного из сервисов стоит
    несколько тысяч, но только за два года, а у другого 249 ₽ — за месяц. В пересчёте на
    месяц картина становится честной:
  </p>
  <ul>
    <li><strong>Capybara:</strong> 249 ₽ за 30 дней, 672 ₽ за 90 дней (224 ₽ в месяц), 1 195 ₽ за 180 дней (около 199 ₽ в месяц).</li>
    <li><strong>Amnezia:</strong> от 290 ₽ в месяц при оплате за два года, 365 ₽ при оплате за год и 448 ₽ за полгода.</li>
    <li><strong>Hiro VPN:</strong> 299 ₽, 399 ₽ и 599 ₽ в месяц; при годовой оплате — 124, 164 и 238 ₽.</li>
    <li><strong>AdGuard VPN:</strong> $11,99 за месяц, $3,99 в месяц при оплате за год и $2,99 при оплате за два года — по курсу на 21 октября 2026 года это примерно 380 ₽ и 285 ₽ в месяц.</li>
  </ul>

  <h2>Ограничения каждого сервиса</h2>
  <p>
    Разбор симметричный: сначала сильные стороны, потом ограничения — в одном порядке для
    каждого сервиса.
  </p>

  <h3>Capybara</h3>
  <ul>
    <li><strong>Сильные стороны:</strong> вход без настройки — ссылки с серверами собирать руками не нужно; полноценный бесплатный день с 10 ГБ без банковской карты; поддержка в Telegram, где отвечает живой человек; входная цена 249 ₽ за месяц.</li>
    <li><strong>Ограничения:</strong> одно устройство в базовом тарифе, дополнительные слоты докупаются; нет self-hosted; меньше локаций, чем у двух самых крупных конкурентов; нет встроенного блокировщика рекламы; нет собственного приложения.</li>
  </ul>

  <h3>Amnezia</h3>
  <ul>
    <li><strong>Сильные стороны:</strong> бесплатный тариф без рекламы и без лимита трафика; семь устройств в премиуме; возможность поднять сервис на своём VPS и получить свой IP; открытый исходный код и режим RAM-only.</li>
    <li><strong>Ограничения:</strong> бесплатный тариф открывает только социально значимые сайты и не пускает YouTube; самые дешёвые цены действуют только при оплате за год или два; вдвое меньше стран, чем у двух конкурентов.</li>
  </ul>

  <h3>Happ</h3>
  <ul>
    <li><strong>Сильные стороны:</strong> не собирает данные; поддерживает VLESS (Reality), VMess и Trojan; приложения под iOS, Android, десктоп, Android TV и Apple TV; лёгкий и бесплатный.</li>
    <li><strong>Ограничения:</strong> это клиент, а не сервис: без своей подписки и без серверов работать не с чем; серверной части, локаций и поддержки у Happ нет; цены не существует.</li>
  </ul>

  <h3>AdGuard VPN</h3>
  <ul>
    <li><strong>Сильные стороны:</strong> безлимитный трафик и до десяти устройств; 75+ локаций; DNS-защита и блокировка рекламы в одном месте; самый широкий набор платформ — от Xbox и PlayStation до роутеров и смарт-телевизоров.</li>
    <li><strong>Ограничения:</strong> бесплатно только 3 ГБ в месяц на два устройства; помесячный тариф — самый дорогой из пяти ($11,99, около 1 140 ₽); используемый протокол на сайте не указан.</li>
  </ul>

  <h3>Hiro VPN</h3>
  <ul>
    <li><strong>Сильные стороны:</strong> готовые приложения без сторонних клиентов; до десяти устройств; встроенный блокировщик рекламы; поддержка 24/7; 80–130+ серверов в зависимости от тарифа.</li>
    <li><strong>Ограничения:</strong> тарифы дороже (299–599 ₽ в месяц), при этом их три, и у каждого своя цифра устройств; в бесплатном пробном периоде расходятся сроки — 7 дней в одном месте и две недели в FAQ; используемый протокол не раскрывается.</li>
  </ul>

  <h2>Где брать данные и как проверять</h2>
  <p>
    Цифры сняты 21 октября 2026 года с публичных страниц сервисов: разделы тарифов
    Amnezia, страница покупки Hiro VPN, тарифы AdGuard VPN и описание Happ. Мы не
    пользовались всеми пятью сервисами и не тестировали скорость — сравниваем только то,
    что сервисы заявляют о себе публично.
  </p>
  <p>
    Цены у конкурентов зависят от периода оплаты, промо и региона, поэтому перед покупкой
    перепроверьте их на сайтах. Наши условия и актуальные тарифы — на странице
    <a href={`${b}/tarify/`}>«Тарифы подробно»</a>, а порядок выбора — в гайде
    <a href={`${b}/kak-vybrat-vpn/`}>«Как выбрать VPN»</a>.
  </p>

  <blockquote>
    Сравнение полезно ровно настолько, насколько честно сформулированы критерии. Наш
    список из десяти пунктов — в гайде <a href={`${b}/kak-vybrat-vpn/`}>«Как выбрать VPN»</a>.
  </blockquote>
</GuideLayout>
