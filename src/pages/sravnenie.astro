---
import GuideLayout from '../layouts/GuideLayout.astro';
import { site } from '../data/site';
import { b } from '../lib/url';
import { lastModifiedDate } from '../lib/dates';

const title = 'Amnezia, Happ, AdGuard, Hiro и Capybara: сравнение VPN-сервисов';
const description =
  'Пять VPN-сервисов и клиентов по одним параметрам: цена, бесплатный доступ, устройства, локации, логи. Данные с сайтов сервисов на 21.10.2026.';
const ogImage = '/og/sravnenie.jpg';

const canonicalPath = '/sravnenie/';
// Дата последней правки — из git, чтобы «Обновлено» всегда было правдой.
const modified = lastModifiedDate(canonicalPath);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl,
    logo: `${site.siteUrl}/logo-320.png` },
  author: { '@type': 'Organization', name: 'Capybara VPN', url: site.siteUrl },
  image: `${site.siteUrl}${ogImage}`,
  mainEntityOfPage: `${site.siteUrl}/sravnenie/`,
  datePublished: '2026-10-21',
  dateModified: modified,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Сравнение VPN', item: `${site.siteUrl}/sravnenie/` },
  ],
};

const faqs = [
  {
    q: 'Чем Capybara VPN отличается от Amnezia?',
    a: 'Составом продукта. У Amnezia три вещи сразу: управляемый VPN, бесплатный тариф с ограниченным списком сайтов и self-hosted на вашем VPS. У Capybara только свой сервис — зато 249 ₽ за 30 дней, бесплатный день с 10 ГБ без карты и никакой возни с сервером, если вы этим не занимаетесь.',
  },
  {
    q: 'У Capybara есть своё приложение?',
    a: 'Нет, и это осознанно. Соединение идёт через VPN-клиент, а Capybara выдаёт готовую ссылку с вашими серверами и локациями: добавили её в клиент, выбрали локацию, включили соединение. Ничего настраивать руками не нужно.',
  },
  {
    q: 'Где найти бесплатный VPN без ограничений?',
    a: 'Постоянного бесплатного доступа без ограничений почти не бывает. У Amnezia есть Free-тариф: без регистрации, без рекламы и без лимита трафика, но через него открываются только социально важные сайты и нет YouTube. У AdGuard VPN бесплатно 3 ГБ в месяц на два устройства. У Capybara — полноценный доступ на сутки: 10 ГБ, карта не нужна.',
  },
  {
    q: 'Какой VPN выбрать, если нужен надёжный доступ из России?',
    a: 'Проверять надо на своих задачах: у каждого сервиса свой набор протоколов и свои серверы, а фильтрация в разных сетях разная. Практичный путь — взять бесплатный пробный период у двух-трёх сервисов и сравнить: в Capybara это первый день с 10 ГБ.',
  },
];
---

<GuideLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  crumbName="Сравнение"
  eyebrow="Гид · Сравнение"
  heading="Пять VPN-сервисов и клиентов в сравнении"
  lead="Amnezia, Happ, AdGuard VPN, Hiro VPN и Capybara — по одним и тем же параметрам: что это за продукт, сколько стоит, что бесплатно, сколько устройств и что с логами."
  guidePath={canonicalPath}
  articleLd={articleLd}
  breadcrumbLd={breadcrumbLd}
  articleSection="Сервис"
  datePublished="2026-10-21"
  dateModified={modified}
  ogImage={ogImage}
  summary="Обзор пяти VPN-продуктов по цифрам с их сайтов на 21 октября 2026 года: цена, бесплатный доступ, устройства, локации, протоколы, логи и поддержка."
  faqs={faqs}
>
  <h2>Сначала о главном: это разные продукты</h2>
  <p>
    Сравнивать эти пять сервисов между собой — примерно как сравнивать телефон
    с оператором связи: к одному относятся приложения и протоколы, к другому —
    серверы и подписка. Поэтому в таблице сначала стоит главное: что именно
    вы получаете.
  </p>
  <ul>
    <li><strong>Capybara VPN</strong> — свой сервис: серверы, локации, протокол, подписка.</li>
    <li><strong>Amnezia VPN</strong> — три продукта сразу: управляемый VPN, бесплатный тариф с ограничениями и self-hosted на вашем VPS.</li>
    <li><strong>Happ</strong> — приложение-клиент без серверов и без подписки: работает с той ссылкой, которую вы принесли сами.</li>
    <li><strong>AdGuard VPN</strong> — freemium-сервис с фильтрацией рекламы и DNS-защитой; бесплатно 3 ГБ в месяц.</li>
    <li><strong>Hiro VPN</strong> — свой сервис со своим приложением, freemium, есть встроенный блокировщик рекламы.</li>
  </ul>

  <h2>Сравнение в одну таблицу</h2>
  <div
    class="table-scroll"
    role="region"
    aria-label="Сравнение VPN-сервисов — таблица прокручивается вбок"
    tabindex="0"
  >
    <table>
      <thead>
        <tr>
          <th>Критерий</th>
          <th>Capybara VPN</th>
          <th>Amnezia</th>
          <th>Happ</th>
          <th>AdGuard VPN</th>
          <th>Hiro VPN</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Что это</td>
          <td>Свой сервис: серверы + подписка</td>
          <td>Managed VPN, Free-тариф и self-hosted</td>
          <td>Только клиент, без серверов и подписки</td>
          <td>Свой сервис с DNS-защитой</td>
          <td>Свой сервис со своим приложением</td>
        </tr>
        <tr>
          <td>Цена от</td>
          <td>249 ₽ за 30 дней</td>
          <td>290 ₽ в месяц при оплате за 2 года</td>
          <td>Нет: сервис не продаёт доступ</td>
          <td>$3,99 в месяц при оплате за год</td>
          <td>299 ₽ в месяц (Base)</td>
        </tr>
        <tr>
          <td>Бесплатно</td>
          <td>Первый день: 10 ГБ, карта не нужна</td>
          <td>Free-тариф: без рекламы и без лимита, но только «важные» сайты и без YouTube</td>
          <td>Нет</td>
          <td>3 ГБ в месяц на 2 устройства</td>
          <td>Пробный период 7 дней</td>
        </tr>
        <tr>
          <td>Трафик в платных</td>
          <td>Безлимит</td>
          <td>Безлимит</td>
          <td>Зависит от сервиса, чью ссылку вы принесли</td>
          <td>Безлимит</td>
          <td>Безлимит</td>
        </tr>
        <tr>
          <td>Устройств одновременно</td>
          <td>1, дополнительные слоты за доплату</td>
          <td>7</td>
          <td>Зависит от клиента</td>
          <td>До 10</td>
          <td>3 / 5 / 10 в зависимости от тарифа</td>
        </tr>
        <tr>
          <td>Локации</td>
          <td>38 локаций, 100+ серверов</td>
          <td>20 стран</td>
          <td>Свои серверы не входят</td>
          <td>75+ локаций</td>
          <td>80–130+ серверов</td>
        </tr>
        <tr>
          <td>Протокол</td>
          <td>VLESS, настроен автоматически</td>
          <td>AmneziaWG 3.1 и XRay VLESS Reality; для self-hosted — 8 протоколов</td>
          <td>VLESS (Reality), VMess, Trojan</td>
          <td>На сайте не указан</td>
          <td>VLESS</td>
        </tr>
        <tr>
          <td>Логи</td>
          <td>Не хранятся, серверы в режиме RAM-only</td>
          <td>Не собирают, RAM-only, открытый код</td>
          <td>Не собирает</td>
          <td>Не хранят, минимальные служебные данные</td>
          <td>Заявляют no-logs, минимальные технические данные</td>
        </tr>
        <tr>
          <td>Реклама</td>
          <td>Нет</td>
          <td>Нет (Free — «ad-free»)</td>
          <td>Не указано</td>
          <td>Не указано</td>
          <td>Не указано, есть встроенный блокировщик рекламы</td>
        </tr>
        <tr>
          <td>Поддержка</td>
          <td>Telegram, живые люди</td>
          <td>Свои каналы и документация</td>
          <td>Своё сообщество</td>
          <td>Своя поддержка</td>
          <td>Поддержка 24/7</td>
        </tr>
        <tr>
          <td>Свой сервер (self-hosted)</td>
          <td>Нет</td>
          <td>Есть</td>
          <td>Нет</td>
          <td>Нет</td>
          <td>Нет</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    Цены конкурентов меняются: у Amnezia и Hiro они зависят от промо и периода
    оплаты, у AdGuard — ещё и от валюты и региона. Все цифры выше сняты с сайтов
    сервисов 21 октября 2026 года; перед покупкой их стоит перепроверить.
  </p>

  <h2>Чем Capybara отличается от остальных</h2>
  <p>
    Различия — без оценок, «лучше» или «хуже». У Capybara своя конфигурация
    продукта, и у неё есть и плюсы, и ограничения:
  </p>
  <ul>
    <li><strong>Цена входа.</strong> 249 ₽ за 30 дней — это 249 ₽ в месяц. Самый дешёвый тариф Amnezia — 290 ₽ в месяц, но только при оплате за два года; за полгода выходит 448 ₽ в месяц. У Hiro — от 299 ₽.</li>
    <li><strong>Пробный доступ.</strong> Первый день бесплатно: 10 ГБ, карта не нужна. У конкурентов пробный период короче, требует карты или ограничен по функциям.</li>
    <li><strong>Ноль настройки.</strong> Сервис выдаёт готовую ссылку с вашими серверами: добавили в VPN-клиент, выбрали локацию, включили соединение.</li>
    <li><strong>Вход без анкет.</strong> Телеграм-бот или браузер — без e-mail, телефона и карты на первом подключении.</li>
    <li><strong>Поддержка в Telegram.</strong> Живой человек отвечает по конкретной ситуации, а не номер тикета.</li>
  </ul>
  <p>
    Ограничения Capybara — тоже часть различия:
  </p>
  <ul>
    <li><strong>Одно устройство в тарифе.</strong> У Amnezia — 7, у AdGuard — до 10, у Hiro — от 3 до 10. У Capybara дополнительные слоты надо докупать отдельно.</li>
    <li><strong>Нет бесплатного тарифа «навсегда».</strong> Есть пробный день. Постоянного бесплатного доступа с лимитом, как у Amnezia Free или AdGuard Free, нет.</li>
    <li><strong>Нет self-hosted.</strong> Свой сервер на своём VPS — это сильная сторона Amnezia, и для части аудитории она важнее цены.</li>
    <li><strong>Меньше локаций.</strong> 38 локаций против 75+ у AdGuard VPN и 80–130 серверов у Hiro.</li>
    <li><strong>Нет встроенного блокировщика рекламы.</strong> У AdGuard и Hiro он есть, у Capybara — нет.</li>
    <li><strong>Нет своего приложения.</strong> Нужен любой VPN-клиент: это лишний шаг, если вы хотите «просто нажал и работает».</li>
  </ul>

  <h2>Кому что подойдёт</h2>
  <p>
    Подробнее о том, как выбирать по критериям, — в гайде
    <a href={`${b}/kak-vybrat-vpn/`}>«Как выбрать VPN»</a>, а о цифрах нашего
    сервиса — на странице <a href={`${b}/fakty/`}>«Все цифры»</a>.
  </p>
  <ul>
    <li><strong>Capybara VPN</strong> — если нужен недорогой VPN на один телефон или ноутбук, без настройки и без возни с сервером.</li>
    <li><strong>Amnezia</strong> — если нужен бесплатный тариф навсегда, много устройств или полный контроль через свой VPS.</li>
    <li><strong>Happ</strong> — если серверы и подписка уже есть, а нужен просто удобный клиент с iOS, Android, TV и десктопа.</li>
    <li><strong>AdGuard VPN</strong> — если важна фильтрация рекламы и DNS-защита вместе с VPN.</li>
    <li><strong>Hiro VPN</strong> — если нужны готовые приложения, 10 устройств и блокировщик рекламы в одном месте.</li>
  </ul>

  <blockquote>
    Не гадайте, какой сервис «правильный»: возьмите бесплатный день у того,
    кто ближе по цене, и проверьте на своих задачах. В Capybara первый день —
    10 ГБ без карты.
  </blockquote>

  <h2>Источники данных</h2>
  <p>
    Все цифры в таблице взяты с публичных страниц сервисов 21 октября 2026 года:
    разделы тарифов Amnezia, страницы «Как купить» у Happ, тарифы AdGuard VPN и
    Hiro VPN. Цены у конкурентов меняются — если цифра расходится с их сайтом,
    правы они. Наши тарифы и условия — на странице
    <a href={`${b}/tarify/`}>«Тарифы подробно»</a>.
  </p>
</GuideLayout>
