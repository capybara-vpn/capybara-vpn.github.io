---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icon';
import { guides } from '../data/guides';
import { withBase } from '../lib/url';

const platforms: { name: string; icon: IconName; note: string }[] = [
  { name: 'iOS', icon: 'phone', note: 'iPhone · iPad' },
  { name: 'Android', icon: 'phone', note: 'смартфоны · планшеты' },
  { name: 'Windows', icon: 'grid', note: 'ПК · ноутбуки' },
  { name: 'macOS', icon: 'laptop', note: 'Mac' },
  { name: 'Linux', icon: 'terminal', note: 'десктоп' },
  { name: 'TV', icon: 'tv', note: 'Smart TV' },
  { name: 'Роутер', icon: 'router', note: 'Wi-Fi роутер' },
] as const;
---

<section id="platforms" class="relative border-y border-line bg-bg-2" aria-labelledby="platforms-title">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center">Платформы</p>
      <h2 id="platforms-title" class="mt-4 text-[clamp(1.7rem,1rem+2.2vw,2.6rem)] font-bold leading-[1.1] tracking-[-0.025em] text-ink">
        Работает на ваших устройствах
      </h2>
      <p class="lead mt-4 text-[16px]">
        Один сервис — знакомая среда везде. Купить VPN можно и для телефона, и для
        компьютера: iOS, Android, Windows, macOS, Linux, TV и роутеры.
      </p>
    </div>

    <ul class="reveal mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-7" aria-label="Поддерживаемые платформы">
      {
        platforms.map((p) => (
          <li class="card card-hover spot flex flex-col items-center gap-1.5 px-3 py-6 text-center">
            <span class="icon-wrap flex h-11 w-11 items-center justify-center rounded-xl border border-brand/25 bg-brand-soft text-brand">
              <Icon name={p.icon} class="h-5.5 w-5.5" />
            </span>
            <h3 class="mt-2 text-[15px] font-semibold text-ink">{p.name}</h3>
            <span class="text-[12px] text-ink-3">{p.note}</span>
          </li>
        ))
      }
    </ul>

    <div class="reveal mx-auto mt-7 max-w-2xl">
      <p class="rounded-2xl border border-amber/35 bg-amber-soft/60 px-5 py-3.5 text-center text-[13.5px] leading-relaxed text-ink-2">
        Важно: цена по умолчанию — за <strong class="font-semibold text-ink">1 устройство</strong>;
        дополнительные слоты поднимают лимит до 10 устройств на тариф.
      </p>
    </div>

    <nav
      class="reveal mx-auto mt-6 flex max-w-2xl flex-wrap items-center justify-center gap-x-2 gap-y-2 text-[13px]"
      aria-label="Инструкции по настройке"
    >
      <span class="text-ink-3">Инструкции:</span>
      {
        guides
          .filter((g) => g.short)
          .map((g) => (
            <a
              href={withBase(g.href)}
              class="chip min-h-[36px] px-3 py-1.5 transition-colors hover:border-brand/50 hover:text-ink"
            >
              {g.short}
            </a>
          ))
      }
    </nav>
  </div>
</section>
