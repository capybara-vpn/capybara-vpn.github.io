---
import { site, nav } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

import { b, withBase } from '../lib/url';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <!-- announcement strip -->
  <div class="border-b border-white/8 bg-[#0b0e14]/80">
    <p class="mx-auto flex max-w-6xl items-center justify-center gap-2 px-4 py-2 text-center text-[12.5px] leading-snug text-[#9aa6b2]">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#60a1a3]" aria-hidden="true"></span>
      <span class="hidden sm:inline">Capybara VPN — спокойный VPN с подпиской от 249 ₽. </span>Подключение через Telegram или браузер.
    </p>
  </div>

  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6" aria-label="Основная навигация">
    <a href={withBase("/#top")} class="flex shrink-0 items-center gap-2.5" aria-label="Capybara VPN — на главную страницу">
      <Logo
        class="h-9 w-9 rounded-full object-cover ring-1 ring-white/15"
        eager
      />
      <span class="whitespace-nowrap text-[15px] font-semibold tracking-tight text-[#f2f4f3]">Capybara VPN</span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {
        nav.map((n) => (
          <a
            href={withBase(n.href)}
            class="text-[14px] font-medium text-[#9aa6b2] transition-colors hover:text-white"
          >
            {n.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href={withBase("/#pricing")}
        class="btn btn-ghost hidden px-4 py-2 text-[13.5px] sm:inline-flex"
      >
        Тарифы
      </a>
      <a
        href={site.telegramUrl}
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        class="btn btn-primary px-4 py-2 text-[13.5px] sm:px-5 sm:py-2.5 sm:text-sm"
        data-cta
        data-placement="header"
        data-destination="telegram"
      >
        <Icon name="telegram" class="h-4 w-4" />
        <span class="sm:hidden">Telegram</span>
        <span class="hidden sm:inline">Открыть в Telegram</span>
        <span class="sr-only"> — Capybara VPN</span>
      </a>
    </div>
  </nav>

  <!-- compact mobile nav -->
  <nav class="border-t border-white/6 lg:hidden" aria-label="Навигация по разделам">
    <div class="mx-auto flex max-w-6xl items-center gap-4 overflow-x-auto px-3.5 py-2 text-[12.5px] font-medium text-[#9aa6b2] sm:gap-5 sm:px-4 sm:text-[13px]" tabindex="0" role="region" aria-label="Навигация по разделам">
      {
        nav.map((n) => (
          <a href={withBase(n.href)} class="whitespace-nowrap py-2 transition-colors hover:text-white">
            {n.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
