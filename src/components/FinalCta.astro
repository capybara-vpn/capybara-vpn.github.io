---
import { site } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---

<!-- Closing band: follows the active theme like every other section. -->
<section
  id="final"
  class="relative overflow-hidden border-t border-line"
  aria-labelledby="final-title"
>
  <div class="ambient left-1/2 top-1/2 h-[480px] w-[min(820px,100vw)] -translate-x-1/2 -translate-y-1/2" style="background: var(--glow)" aria-hidden="true"></div>
  <div class="dotgrid absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="reveal relative mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:py-32">
    <Logo class="h-24 w-24 rounded-full object-cover shadow-[0_24px_70px_-22px_rgba(96,161,163,0.32)] ring-1 ring-line-strong sm:h-28 sm:w-28" alt={site.logo.alt} large />
    <h2 id="final-title" class="display mt-8 text-[clamp(2rem,1.2rem+3vw,3.4rem)] text-ink">
      Попробуйте Capybara сегодня
    </h2>
    <p class="lead mt-4 max-w-xl text-[16px]">
      Тарифы от 249 ₽, подключение за пару минут, безлим уже внутри.
      Выберите, где удобнее начать.
    </p>
    <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a
        href={site.browserUrl}
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        class="btn btn-primary px-8 py-4 text-[16px]"
        data-cta
        data-placement="final"
        data-destination="browser"
      >
        <Icon name="globe" class="h-5 w-5" />
        Продолжить в браузере
        <span class="sr-only"> — Capybara VPN</span>
      </a>
      <a
        href={site.telegramUrl}
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        class="btn btn-ghost px-8 py-4 text-[16px]"
        data-cta
        data-placement="final"
        data-destination="telegram"
      >
        <Icon name="telegram" class="h-5 w-5" />
        Открыть в Telegram
        <span class="sr-only"> — Capybara VPN</span>
      </a>
    </div>
    <p class="mono mt-6 text-[12px] tracking-wide text-ink-3">1 день бесплатно, без карты · до 10 устройств / тариф · VLESS · 38 локаций</p>
  </div>
</section>
