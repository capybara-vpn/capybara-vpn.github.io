---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="reveal card spot relative mt-12 overflow-hidden border-brand/35 p-7 text-center sm:p-10" style="background: linear-gradient(165deg, color-mix(in oklab, var(--brand) 14%, var(--surface)), var(--surface) 60%)">
  <div class="ambient -right-16 -top-16 h-56 w-56" style="background: var(--glow)" aria-hidden="true"></div>
  <p class="display relative text-2xl text-ink sm:text-3xl">Попробуйте Capybara сегодня</p>
  <p class="lead relative mx-auto mt-3 max-w-md text-[15px]">
    Первый день бесплатно, без карты. Подключение за пару минут.
  </p>
  <div class="relative mt-6 flex flex-col justify-center gap-3 sm:flex-row">
    <a
      href={site.browserUrl}
      target="_blank"
      rel="noopener noreferrer sponsored nofollow"
      class="btn btn-primary px-6 py-3.5 text-[15px]"
      data-cta
      data-placement="guide"
      data-destination="browser"
    >
      <Icon name="globe" class="h-5 w-5" />
      Продолжить в браузере
      <span class="sr-only"> — Capybara VPN</span>
    </a>
    <a
      href={site.telegramUrl}
      target="_blank"
      rel="noopener noreferrer sponsored nofollow"
      class="btn btn-ghost px-6 py-3.5 text-[15px]"
      data-cta
      data-placement="guide"
      data-destination="telegram"
    >
      <Icon name="telegram" class="h-5 w-5" />
      Открыть в Telegram
      <span class="sr-only"> — Capybara VPN</span>
    </a>
  </div>
</div>
