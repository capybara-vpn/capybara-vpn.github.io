---
import { site } from '../data/site';
---

<!--
  Consent is a NON-MODAL floating card pinned above the bottom edge. The old
  full-width bar covered hero CTAs on small phones; this card never overlaps
  the primary actions, and the mobile sticky bar steps aside while a choice
  is pending (html.has-consent).
-->
<div
  id="consent"
  class="fixed inset-x-3 bottom-3 z-[70] hidden sm:inset-x-auto sm:bottom-4 sm:left-1/2 sm:w-[min(560px,calc(100vw-2rem))] sm:-translate-x-1/2"
  role="region"
  aria-label="Настройка аналитики"
>
  <div class="glass rounded-2xl border border-line-strong p-3 shadow-[var(--shadow-pop)] sm:px-4">
    <div class="flex items-center gap-3">
      <p class="min-w-0 flex-1 text-[12.5px] leading-snug text-ink-2 sm:text-[13px]">
        Аналитика — на ваш выбор.
        <span class="sr-only sm:not-sr-only">Яндекс Метрика собирает обезличенную статистику работы сайта; GA4 подключаем только с вашего согласия.</span>
      </p>
      <div class="flex shrink-0 gap-2">
        <button id="consent-accept" type="button" class="btn btn-primary px-3.5 py-2.5 text-[12.5px] sm:text-[13px]">
          Разрешить
        </button>
        <button id="consent-decline" type="button" class="btn btn-ghost bg-surface/70 px-3.5 py-2.5 text-[12.5px] sm:text-[13px]">
          Не сейчас
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Re-open the analytics choice. Only shown once a choice has been made,
     so it never competes with the card above for the same corner. -->
<div id="consent-manage-wrap" class="fixed bottom-[calc(5rem+env(safe-area-inset-bottom))] right-3 z-[70] hidden md:bottom-6 md:right-6">
  <button
    id="consent-manage"
    type="button"
    class="glass rounded-full border border-line px-3.5 py-2 text-[12px] font-medium text-ink-2 transition-colors hover:text-ink"
    aria-label="Изменить настройки аналитики"
  >
    Cookie
  </button>
</div>
<span id="ga-id" class="hidden" aria-hidden="true">{site.gaId}</span>
