---
import { site } from '../data/site';
---

<div
  id="consent"
  class="hidden fixed bottom-[calc(5rem+env(safe-area-inset-bottom))] left-3 z-[70] max-w-[min(320px,calc(100vw-7rem))] rounded-2xl border border-white/12 bg-[#12151c]/95 p-4 shadow-2xl backdrop-blur-xl md:bottom-6 md:left-6"
  role="dialog"
  aria-modal="true"
  aria-live="polite"
  aria-label="Настройка аналитики"
>
  <p class="text-[13.5px] font-semibold text-white">Аналитика — на ваш выбор</p>
  <p class="mt-1.5 text-[12.5px] leading-relaxed text-[#9aa6b2]">
    Используем GA4 только для улучшения страницы. До согласия сбор отключён.
  </p>
  <div class="mt-3 flex gap-2">
    <button id="consent-accept" type="button" class="btn btn-primary flex-1 px-3 py-2.5 text-[13px]">
      Разрешить
    </button>
    <button id="consent-decline" type="button" class="btn btn-ghost flex-1 px-3 py-2.5 text-[13px]">
      Не сейчас
    </button>
  </div>
  <span id="ga-id" class="hidden" aria-hidden="true">{site.gaId}</span>
</div>

<div class="fixed bottom-[calc(5rem+env(safe-area-inset-bottom))] right-3 z-[70] md:bottom-6 md:right-6">
  <button
    id="consent-manage"
    type="button"
    class="hairline rounded-full bg-[#12151c]/90 px-3.5 py-2 text-[12px] font-medium text-[#9aa6b2] backdrop-blur-xl transition-colors hover:text-white"
    aria-label="Изменить настройки аналитики"
  >
    Cookie
  </button>
</div>
