---
import { faqs } from '../data/site';

/* Questions/answers live in src/data/site.ts (faqs) — single source with FAQPage JSON-LD. */
---

<section id="faq" class="relative mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:py-28" aria-labelledby="faq-title">
  <div class="reveal text-center">
    <p class="eyebrow justify-center">Частые вопросы</p>
    <h2 id="faq-title" class="mt-4 text-[clamp(1.7rem,1rem+2.2vw,2.6rem)] font-bold leading-[1.1] tracking-[-0.025em] text-ink">
      Вопросы и честные ответы
    </h2>
    <p class="lead mt-4 text-[16px]">
      Честные ответы без мелкого шрифта.
    </p>
  </div>

  <div class="mt-10 grid gap-2.5">
    {
      faqs.map((f, i) => (
        <details class="faq reveal spot" style={`--reveal-delay:${Math.min(i, 4) * 60}ms`}>
          <summary class="flex items-center justify-between gap-4 px-5 py-4 text-left sm:px-6 sm:py-5">
            {/* An honest h3 inside summary (valid per HTML spec) instead of a
                role="heading" span hack — screen readers and Yandex parsers
                agree on it. */}
            <h3 class="text-[15.5px] font-semibold tracking-tight text-ink">{f.q}</h3>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="faq-body">
            <div>
              <p class="px-5 pb-5 text-[14.5px] leading-relaxed text-ink-2 sm:px-6">{f.a}</p>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
