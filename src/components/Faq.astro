---
import Icon from './Icon.astro';
import { faqs } from '../data/site';

/* Questions/answers live in src/data/site.ts (faqs) — single source with FAQPage JSON-LD. */
---

<section id="faq" class="relative mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:py-28" aria-labelledby="faq-title">
  <div class="reveal text-center">
    <p class="eyebrow justify-center">Частые вопросы</p>
    <h2 id="faq-title" class="display mt-4 text-4xl text-white sm:text-5xl">
      Вопросы и честные ответы
    </h2>
    <p class="lead mt-4 text-[16px]">
      Честные ответы без мелкого шрифта.
    </p>
  </div>

  <div class="mt-10 space-y-3">
    {
      faqs.map((f, i) => (
        <details class="faq reveal group" style={`--reveal-delay:${Math.min(i, 4) * 60}ms`}>
          <summary class="flex items-center justify-between gap-4 px-5 py-4 text-left sm:px-6 sm:py-5">
            <span role="heading" aria-level="3" class="text-[15.5px] font-semibold tracking-tight text-white">{f.q}</span>
            <span class="chev flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 text-[#8fc3c4]">
              <Icon name="chevron" class="h-4 w-4" />
            </span>
          </summary>
          <div class="faq-body">
            <div>
              <p class="px-5 pb-5 text-[14.5px] leading-relaxed text-[#9aa6b2] sm:px-6">{f.a}</p>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
