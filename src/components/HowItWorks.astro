---
import { site } from '../data/site';
import Icon from './Icon.astro';

const steps = [
  {
    n: '01',
    title: 'Выберите тариф',
    text: '30, 90 или 180 дней. Цена видна сразу: 249 ₽, 672 ₽ или 1195 ₽. Каждый тариф — безлим на 1 устройство.',
  },
  {
    n: '02',
    title: 'Откройте Capybara',
    text: 'В Telegram — если удобно там. В браузере — если проще без мессенджера. Оба пути ведут к одной подписке.',
  },
  {
    n: '03',
    title: 'Подключитесь',
    text: 'Следуйте короткой инструкции в сервисе: выберите локацию и включите соединение. Всё.',
  },
];
---

<section id="how" class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28" aria-labelledby="how-title">
  <div class="reveal max-w-2xl">
    <p class="eyebrow">Как это работает</p>
    <h2 id="how-title" class="display mt-4 text-4xl text-white sm:text-5xl">
      Подключение за несколько шагов
    </h2>
    <p class="lead mt-4 text-[16px]">Ничего лишнего: три коротких действия — и вы онлайн.</p>
  </div>

  <div class="absolute left-0 right-0 top-10 hidden h-px bg-gradient-to-r from-transparent via-[#60a1a3]/40 to-transparent lg:block" aria-hidden="true"></div>
  <ol class="relative mt-12 grid gap-4 lg:grid-cols-3">
    {
      steps.map((s, i) => (
        <li
          class="reveal hairline relative rounded-3xl bg-[#12151c]/80 p-7 sm:p-8"
          style={`--reveal-delay:${i * 100}ms`}
        >
          <p class="display text-[52px] text-transparent" style="-webkit-text-stroke: 1px rgba(143,195,196,.55)">
            {s.n}
          </p>
          <h3 class="mt-3 text-[19px] font-semibold tracking-tight text-white">{s.title}</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-[#9aa6b2]">{s.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row">
    <a
      href={site.telegramUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="btn btn-primary px-6 py-3.5 text-[15px]"
      data-cta
      data-placement="how"
      data-destination="telegram"
      aria-label="Начать подключение через Telegram"
    >
      <Icon name="telegram" class="h-5 w-5" />
      Подключиться в Telegram
    </a>
    <a
      href={site.browserUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="btn btn-ghost px-6 py-3.5 text-[15px]"
      data-cta
      data-placement="how"
      data-destination="browser"
      aria-label="Начать подключение в браузере"
    >
      <Icon name="browser" class="h-5 w-5 text-[#8fc3c4]" />
      Продолжить в браузере
    </a>
  </div>
</section>
