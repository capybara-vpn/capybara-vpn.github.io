---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icon';

const cards: { icon: IconName; title: string; text: string; metric: string }[] = [
  {
    icon: 'gauge',
    title: 'Скорость без нервов',
    text: 'Современный протокол VLESS и каналы до 10 Гбит/с. Видео, звонки и лента — без долгой загрузки.',
    metric: 'до 10 Гбит/с',
  },
  {
    icon: 'globe',
    title: 'География на выбор',
    text: '38 локаций и 100+ серверов. Переключайтесь между странами в пару касаний.',
    metric: '38 локаций',
  },
  {
    icon: 'bolt',
    title: 'Простота подключения',
    text: 'Никаких конфигов вручную. Открыли бота или браузер, нажали пару кнопок — готово.',
    metric: '≈ 2 минуты',
  },
  {
    icon: 'eye',
    title: 'Спокойная приватность',
    text: 'Минимум лишних данных: никаких сложных анкет. Серверы работают в режиме RAM-only — без долговременных логов.',
    metric: 'RAM-only',
  },
  {
    icon: 'telegram',
    title: 'Поддержка в Telegram',
    text: 'Живая помощь там, где вы уже есть. Вопрос, сообщение, ответ. Без тикет-систем.',
    metric: 'в Telegram',
  },
  {
    icon: 'device',
    title: 'Ваши устройства',
    text: 'iOS, Android, Windows, macOS, Linux и TV. Знакомая среда везде, где вы смотрите и работаете.',
    metric: 'до 10 устройств',
  },
];
---

<!-- Bento: two wide feature tiles, then a 3-up row. Spotlight hover on all. -->
<section id="benefits" class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24" aria-labelledby="benefits-title">
  <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-2xl">
      <p class="eyebrow">Почему Capybara</p>
      <h2 id="benefits-title" class="mt-4 text-[clamp(1.7rem,1rem+2.2vw,2.6rem)] font-bold leading-[1.1] tracking-[-0.025em] text-ink">
        Спокойный сервис для быстрого интернета
      </h2>
    </div>
    <p class="lead max-w-sm text-[15px]">
      Техника на втором плане. На первом — ощущение, что всё просто работает.
    </p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
    <!-- wide tile 1: speed -->
    <article class="reveal card card-hover spot relative overflow-hidden p-7 sm:p-8 lg:col-span-3" style="--reveal-delay:0ms">
      <div class="ambient -right-10 -top-10 h-44 w-44" style="background: var(--glow)" aria-hidden="true"></div>
      <span class="icon-wrap flex h-12 w-12 items-center justify-center rounded-2xl border border-brand/30 bg-brand-soft text-brand">
        <Icon name="gauge" class="h-6 w-6" />
      </span>
      <p class="display mt-6 text-[clamp(2.2rem,1.4rem+2vw,3.2rem)] text-ink">до 10 Гбит/с</p>
      <svg class="mt-2 h-10 w-full max-w-[340px]" viewBox="0 0 320 40" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 32 L28 28 L52 33 L76 20 L104 26 L128 12 L156 20 L182 8 L210 16 L240 6 L270 12 L300 4 L320 8" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="spark-flow" />
      </svg>
      <h3 class="mt-3 text-[19px] font-semibold tracking-tight text-ink">Скорость без нервов</h3>
      <p class="mt-2.5 max-w-md text-[14.5px] leading-relaxed text-ink-2">Современный протокол VLESS и каналы до 10 Гбит/с. Видео, звонки и лента — без долгой загрузки.</p>
    </article>

    <!-- wide tile 2: geography -->
    <article class="reveal card card-hover spot relative overflow-hidden p-7 sm:p-8 lg:col-span-3" style="--reveal-delay:90ms">
      <div class="ambient -left-10 -bottom-10 h-44 w-44" style="background: var(--glow-warm)" aria-hidden="true"></div>
      <span class="icon-wrap flex h-12 w-12 items-center justify-center rounded-2xl border border-brand/30 bg-brand-soft text-brand">
        <Icon name="globe" class="h-6 w-6" />
      </span>
      <p class="display mt-6 text-[clamp(2.2rem,1.4rem+2vw,3.2rem)] text-ink">38 локаций</p>
      <div class="mt-3 flex flex-wrap gap-1.5" aria-hidden="true">
        {['🇳🇱', '🇩🇪', '🇫🇷', '🇺🇸', '🇯🇵', '🇸🇬', '🇸🇪', '🇵🇱', '+31'].map((f) => (
          <span class="chip px-2.5 py-1 text-[13px]">{f}</span>
        ))}
      </div>
      <h3 class="mt-3 text-[19px] font-semibold tracking-tight text-ink">География на выбор</h3>
      <p class="mt-2.5 max-w-md text-[14.5px] leading-relaxed text-ink-2">38 локаций и 100+ серверов. Переключайтесь между странами в пару касаний.</p>
    </article>

    {
      cards.slice(2).map((c, i) => (
        <article
          class="reveal card card-hover spot p-6 sm:p-7 lg:col-span-3"
          style={`--reveal-delay:${(i + 2) * 70}ms`}
        >
          <span class="icon-wrap flex h-12 w-12 items-center justify-center rounded-2xl border border-brand/30 bg-brand-soft text-brand">
            <Icon name={c.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-[18px] font-semibold tracking-tight text-ink">{c.title}</h3>
          <p class="mt-2.5 text-[14px] leading-relaxed text-ink-2">{c.text}</p>
          <p class="mono mt-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface-2 px-3 py-1.5 text-[12px] font-semibold text-ink-2">
            <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true" />
            {c.metric}
          </p>
        </article>
      ))
    }
  </div>
</section>
