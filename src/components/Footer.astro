---
import { site } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL ?? '/';
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const withBase = (p: string) => `${b}${p}`;
const logoSrc = `${b}/logo-96.png`;
---

<footer class="border-t border-white/8 bg-[#090c11]" aria-label="Подвал сайта">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 lg:flex-row lg:items-start lg:justify-between">
    <div class="max-w-sm">
      <a href="#top" class="flex items-center gap-2.5" aria-label="Capybara VPN — наверх">
        <img src={logoSrc} alt="" width="32" height="32" loading="lazy" decoding="async" class="h-8 w-8 rounded-full object-cover ring-1 ring-white/15" />
        <span class="text-[15px] font-semibold tracking-tight text-white">Capybara VPN</span>
      </a>
      <p class="mt-4 text-[13.5px] leading-relaxed text-[#8b98a5]">
        Спокойный и быстрый VPN. Подключение через Telegram или браузер.
        Тарифы от 249 ₽, каждый — на 1 устройство.
      </p>
      <div class="mt-5 flex gap-2">
        <a
          href={site.telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost px-4 py-2.5 text-[13.5px]"
          data-cta
          data-placement="footer"
          data-destination="telegram"
          aria-label="Capybara VPN в Telegram"
        >
          <Icon name="telegram" class="h-4 w-4 text-[#8fc3c4]" />
          Telegram
        </a>
        <a
          href={site.browserUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost px-4 py-2.5 text-[13.5px]"
          data-cta
          data-placement="footer"
          data-destination="browser"
          aria-label="Capybara VPN в браузере"
        >
          <Icon name="globe" class="h-4 w-4 text-[#8fc3c4]" />
          Браузер
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-8 sm:flex-row sm:gap-16">
      <nav class="flex flex-col gap-2.5 text-[14px]" aria-label="Навигация в подвале">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#8b98a5]">Разделы</h2>
        <a href={withBase('/#benefits')} class="text-[#9aa6b2] transition-colors hover:text-white">Возможности</a>
        <a href={withBase('/#how')} class="text-[#9aa6b2] transition-colors hover:text-white">Как это работает</a>
        <a href={withBase('/#platforms')} class="text-[#9aa6b2] transition-colors hover:text-white">Устройства</a>
        <a href={withBase('/#pricing')} class="text-[#9aa6b2] transition-colors hover:text-white">Тарифы</a>
        <a href={withBase('/#faq')} class="text-[#9aa6b2] transition-colors hover:text-white">FAQ</a>
      </nav>

      <nav class="flex flex-col gap-2.5 text-[14px]" aria-label="Гид по сервису">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#8b98a5]">Гид</h2>
        <a href={withBase('/tarify/')} class="text-[#9aa6b2] transition-colors hover:text-white">Тарифы подробно</a>
        <a href={withBase('/vless/')} class="text-[#9aa6b2] transition-colors hover:text-white">Что такое VLESS</a>
        <a href={withBase('/ios/')} class="text-[#9aa6b2] transition-colors hover:text-white">Настройка на iOS</a>
        <a href={withBase('/android/')} class="text-[#9aa6b2] transition-colors hover:text-white">Настройка на Android</a>
        <a href={withBase('/windows/')} class="text-[#9aa6b2] transition-colors hover:text-white">Настройка на Windows</a>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/6">
    <div class="mx-auto max-w-6xl px-4 py-5 text-[12.5px] text-[#8b98a5] sm:px-6">
      <p>© {year} Capybara VPN. Все права защищены.</p>
    </div>
  </div>
  <!-- spacer so mobile sticky bar never covers footer content -->
  <div class="h-[76px] md:hidden" aria-hidden="true"></div>
</footer>
