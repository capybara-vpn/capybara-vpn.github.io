---
import { site } from '../data/site';
import { guides } from '../data/guides';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
import { withBase } from '../lib/url';

/** Columns of the footer navigation. */
const GROUPS = {
  'установка': { title: 'Установка', label: 'Настройка на устройствах' },
  'основы': { title: 'Гид', label: 'Гид по сервису' },
  'сервис': { title: 'Тарифы и сервис', label: 'Тарифы и сервис' },
  'сценарии': { title: 'Сценарии', label: 'Задачи и сценарии' },
} as const;
type Group = keyof typeof GROUPS;
const groupKeys = Object.keys(GROUPS) as Group[];
---

<footer class="border-t border-white/8 bg-[#090c11]" aria-label="Подвал сайта">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <!--
      Весь подвал — одна сетка. Бренд занимает первые две колонки, ряд ссылок
      на разделы — последние две, ниже идут колонки гайдов. Благодаря общей
      сетке край ряда ссылок совпадает с краем последней колонки, а не висит
      отдельно в углу.
    -->
    <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="max-w-sm sm:col-span-2 lg:col-span-2">
        <a href="#top" class="flex items-center gap-2.5" aria-label="Capybara VPN — наверх">
          <Logo class="h-8 w-8 rounded-full object-cover ring-1 ring-white/15" />
          <span class="text-[15px] font-semibold tracking-tight text-white">Capybara VPN</span>
        </a>
        <p class="mt-4 text-[13.5px] leading-relaxed text-[#8b98a5]">
          Спокойный и быстрый VPN. Подключение через Telegram
          <span class="sr-only"> — Capybara VPN</span> или браузер.
          Тарифы от 249 ₽ — до 10 устройств на тариф
          (базово 1, слоты докупаются).
        </p>
        <div class="mt-5 flex gap-2">
          <a
            href={site.browserUrl}
            target="_blank"
            rel="noopener noreferrer sponsored nofollow"
            class="btn btn-ghost px-4 py-2.5 text-[13.5px]"
            data-cta
            data-placement="footer"
            data-destination="browser"
          >
            <Icon name="globe" class="h-4 w-4 text-[#8fc3c4]" />
            Браузер
            <span class="sr-only"> — Capybara VPN</span>
          </a>
          <a
            href={site.telegramUrl}
            target="_blank"
            rel="noopener noreferrer sponsored nofollow"
            class="btn btn-ghost px-4 py-2.5 text-[13.5px]"
            data-cta
            data-placement="footer"
            data-destination="telegram"
          >
            <Icon name="telegram" class="h-4 w-4 text-[#8fc3c4]" />
            Telegram
          </a>
        </div>
      </div>

      <nav
        class="flex flex-wrap gap-x-6 gap-y-2 self-start text-[14px] sm:col-span-2 lg:col-span-2"
        aria-label="Разделы сайта"
      >
        <a href={withBase('/#benefits')} class="py-2 text-[#9aa6b2] transition-colors hover:text-white">Возможности</a>
        <a href={withBase('/#how')} class="py-2 text-[#9aa6b2] transition-colors hover:text-white">Как это работает</a>
        <a href={withBase('/#platforms')} class="py-2 text-[#9aa6b2] transition-colors hover:text-white">Устройства</a>
        <a href={withBase('/#pricing')} class="py-2 text-[#9aa6b2] transition-colors hover:text-white">Тарифы</a>
        <a href={withBase('/#faq')} class="py-2 text-[#9aa6b2] transition-colors hover:text-white">FAQ</a>
      </nav>

      {
        groupKeys.map((group) => (
          /* <details> on mobile: the four guide columns are 30+ taps of small
             text at the very end of the page; two are open by default, the
             rest collapse. From md up CSS (details.footer-col) keeps every
             column permanently expanded, so the desktop grid is unchanged. */
          <details
            class="footer-col"
            data-footer-default={group === 'установка' || group === 'сервис' ? 'open' : undefined}
          >
            <summary>
              <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#8b98a5]">
                {GROUPS[group].title}
              </span>
              {/* No Tailwind display utilities on this span: the md+ hide rule
                  lives in the components layer and would lose the cascade
                  battle against a `flex` utility class. */}
              <span class="footer-chev" aria-hidden="true">
                <Icon name="chevron" class="h-3.5 w-3.5" />
              </span>
            </summary>
            <nav class="footer-body" aria-label={GROUPS[group].label}>
              <div>
                <div class="flex flex-col gap-2.5 py-2.5 text-[14px]">
                  {guides
                    .filter((g) => g.group === group)
                    .map((g) => (
                      <a href={withBase(g.href)} class="py-2 text-[#9aa6b2] transition-colors hover:text-white">
                        {g.title}
                      </a>
                    ))}
                </div>
              </div>
            </nav>
          </details>
        ))
      }
    </div>
  </div>

  <div class="border-t border-white/6">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-5 text-[12.5px] text-[#8b98a5] sm:px-6">
      <p>© {year} Capybara VPN. Все права защищены.</p>
      {/* Legal links live next to the copyright — audit 2026-11-11: the site
          collects analytics consent, so policy/terms/contacts must be
          reachable from every page. */}
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <a href={withBase('/privacy/')} class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-white">Политика</a>
        <a href={withBase('/oferta/')} class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-white">Условия</a>
        <a href={withBase('/refund/')} class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-white">Возврат</a>
        <a href={withBase('/contacts/')} class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-white">Контакты</a>
        <a
          href={withBase('/pricing.md')}
          class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-white"
          title="Тарифы в Markdown — для ИИ-агентов и покупающих ботов"
        >
          Тарифы в Markdown
        </a>
      </div>
    </div>
  </div>
  <!-- spacer so mobile sticky bar never covers footer content -->
  <div class="h-[calc(76px+env(safe-area-inset-bottom))] md:hidden" aria-hidden="true"></div>
</footer>
