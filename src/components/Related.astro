---
import { guides } from '../data/guides';
import { withBase } from '../lib/url';

interface Props {
  /** Path of the current page, e.g. '/ios/'. */
  current: string;
}

const { current } = Astro.props;

const byPath = Object.fromEntries(guides.map((g) => [g.href, g]));
const currentGuide = byPath[current];

// Explicit related links first, then fill up with the rest so every block
// still shows four items.
const relatedPaths = currentGuide?.related ?? [];
const fill = guides.filter((g) => g.href !== current && !relatedPaths.includes(g.href));
const items = [...relatedPaths, ...fill.map((g) => g.href)]
  .map((p) => byPath[p])
  .filter(Boolean)
  .slice(0, 4);
---

<nav class="reveal mt-14" aria-label="Читайте также">
  <h2 class="text-[12px] font-semibold uppercase tracking-[0.16em] text-[#8b98a5]">Читайте также</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      items.map((g) => (
        <li>
          <a
            href={withBase(g.href)}
            class="card-lift glass group flex items-center justify-between gap-3 rounded-2xl px-5 py-4"
          >
            <span>
              <span class="block text-[15px] font-semibold tracking-tight text-white">{g.title}</span>
              <span class="mt-0.5 block text-[13px] text-[#8b98a5]">{g.note}</span>
            </span>
            <span class="text-[#8fc3c4] transition-transform group-hover:translate-x-1" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
