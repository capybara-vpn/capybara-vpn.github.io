---
import { guides } from '../data/guides';
import { withBase } from '../lib/url';

interface Props {
  /** Path of the current page, e.g. '/ios/'. */
  current: string;
}

const { current } = Astro.props;

const byPath = Object.fromEntries(guides.map((g) => [g.href, g]));
const currentGuide = byPath[current];

// Explicit related links first, then fill up with the rest so every block
// still shows four items.
const relatedPaths = currentGuide?.related ?? [];
const fill = guides.filter((g) => g.href !== current && !relatedPaths.includes(g.href));
const items = [...relatedPaths, ...fill.map((g) => g.href)]
  .map((p) => byPath[p])
  .filter(Boolean)
  .slice(0, 4);
---

<nav class="reveal mt-14" aria-label="Читайте также">
  {/* <p> вместо <h2>: это подпись навигационного блока, а не раздел статьи —
      лишний h2 в конце каждой страницы размывал структуру заголовков. */}
  <p class="mono text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-3">Читайте также</p>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      items.map((g) => (
        <li>
          <a
            href={withBase(g.href)}
            class="card card-hover spot group flex items-center justify-between gap-3 px-5 py-4"
          >
            <span class="min-w-0">
              <span class="block text-[15px] font-semibold tracking-tight text-ink">{g.title}</span>
              <span class="mt-0.5 block text-[13px] text-ink-3">{g.note}</span>
            </span>
            <span class="text-brand transition-transform group-hover:translate-x-1" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
