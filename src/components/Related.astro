---
interface Props {
  current: string;
}

const { current } = Astro.props;

const guides = [
  { href: '/tarify/', title: 'Тарифы Capybara VPN', note: '30, 90 и 180 дней' },
  { href: '/vless/', title: 'Что такое VLESS', note: 'протокол простыми словами' },
  { href: '/ios/', title: 'Настройка на iOS', note: 'iPhone и iPad' },
  { href: '/android/', title: 'Настройка на Android', note: 'смартфоны и планшеты' },
  { href: '/windows/', title: 'Настройка на Windows', note: 'ПК и ноутбуки' },
];

const base = import.meta.env.BASE_URL ?? '/';
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const withBase = (p: string) => `${b}${p}`;
const items = guides.filter((g) => withBase(g.href) !== current);
---

<nav class="reveal mt-14" aria-label="Читайте также">
  <h2 class="text-[12px] font-semibold uppercase tracking-[0.16em] text-[#8b98a5]">Читайте также</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      items.slice(0, 4).map((g) => (
        <li>
          <a
            href={withBase(g.href)}
            class="card-lift glass group flex items-center justify-between gap-3 rounded-2xl px-5 py-4"
          >
            <span>
              <span class="block text-[15px] font-semibold tracking-tight text-white">{g.title}</span>
              <span class="mt-0.5 block text-[13px] text-[#8b98a5]">{g.note}</span>
            </span>
            <span class="text-[#8fc3c4] transition-transform group-hover:translate-x-1" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
