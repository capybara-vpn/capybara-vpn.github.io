---
import { site, plans } from '../data/site';
import Icon from './Icon.astro';

const fmt = (n: number) => `${n.toLocaleString('ru-RU')} ₽`;
---

<section id="pricing" class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28" aria-labelledby="pricing-title">
  <div class="ambient left-1/2 top-24 h-[380px] w-[min(720px,100vw)] -translate-x-1/2 bg-[#60a1a3]/10" aria-hidden="true"></div>

  <div class="reveal relative mx-auto max-w-2xl text-center">
    <p class="eyebrow justify-center">Тарифы Capybara VPN</p>
    <h2 id="pricing-title" class="display mt-4 text-4xl text-white sm:text-5xl">
      Выберите свой ритм
    </h2>
    <p class="lead mt-4 text-[16px]">
      Три честных тарифа. Везде — безлимитный трафик на 1 устройство.
      Чем дольше срок, тем ниже цена за месяц.
    </p>
  </div>

  <div class="relative mt-12 grid gap-4 lg:grid-cols-3 lg:items-stretch">
    {
      plans.map((p, i) => (
        <article
          class:list={[
            'reveal card-lift relative flex flex-col rounded-3xl p-7 sm:p-8',
            p.featured
              ? 'border max-lg:order-first border-[#60a1a3]/45 bg-gradient-to-b from-[#60a1a3]/16 to-[#12151c] shadow-[0_30px_80px_-30px_rgba(96,161,163,0.5)] lg:-my-3 lg:py-11'
              : 'glass',
          ]}
          style={`--reveal-delay:${i * 90}ms`}
          aria-label={`Тариф ${p.days} дней за ${p.price} рублей`}
        >
          {p.featured && (
            <p class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-[#60a1a3] px-4 py-1.5 text-[12px] font-bold uppercase tracking-[0.08em] text-[#061114]">
              Максимальная экономия
            </p>
          )}
          <div class="flex items-center justify-between">
            <h3 class="text-[15px] font-semibold uppercase tracking-[0.12em] text-[#9aa6b2]">
              {p.days} дней
            </h3>
            {p.discount > 0 ? (
              <span class="rounded-full border border-[#60a1a3]/40 bg-[#60a1a3]/12 px-3 py-1 text-[13px] font-bold text-[#8fc3c4]">
                −{p.discount}%
              </span>
            ) : (
              <span class="rounded-full border border-white/10 bg-white/[0.05] px-3 py-1 text-[13px] font-semibold text-[#9aa6b2]">
                старт
              </span>
            )}
          </div>

          <p class="display mt-4 text-[46px] text-white" data-count={p.price}>
            {fmt(p.price)}
          </p>
          <p class="mt-1 text-[13.5px] text-[#8b98a5]">
            {p.per30Label}
            {p.savings > 0 && <span> · экономия {fmt(p.savings)}</span>}
          </p>

          <ul class="mt-6 space-y-2.5 text-[14.5px] text-[#c6d4d4]">
            <li class="flex items-center gap-2.5">
              <Icon name="check" class="h-4 w-4 shrink-0 text-[#8fc3c4]" />
              Безлимитный трафик
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="check" class="h-4 w-4 shrink-0 text-[#8fc3c4]" />
              1 устройство
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="check" class="h-4 w-4 shrink-0 text-[#8fc3c4]" />
              VLESS · 38 локаций
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="check" class="h-4 w-4 shrink-0 text-[#8fc3c4]" />
              Поддержка в Telegram
            </li>
          </ul>

          <a
            href={site.browserUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['btn mt-7 w-full px-6 py-3.5 text-[15px]', p.featured ? 'btn-primary' : 'btn-ghost']}
            data-cta
            data-placement="pricing"
            data-destination="browser"
            data-tariff={p.id}
            aria-label={`Подключить тариф ${p.days} дней за ${p.price} рублей в браузере`}
          >
            Подключить
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <p class="mt-3 text-center text-[12.5px] text-[#8b98a5]">
            Оплата картой, СБП и другими способами
          </p>
        </article>
      ))
    }
  </div>

  <div class="reveal relative mx-auto mt-10 max-w-2xl text-center">
    <p class="text-[15px] text-[#9aa6b2]">Откройте Capybara в Telegram — или продолжите в браузере.</p>
    <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href={site.telegramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary px-6 py-3.5 text-[15px]"
        data-cta
        data-placement="pricing"
        data-destination="telegram"
        aria-label="Открыть Capybara VPN в Telegram из блока тарифов"
      >
        <Icon name="telegram" class="h-5 w-5" />
        Открыть в Telegram
      </a>
      <a
        href={site.browserUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost px-6 py-3.5 text-[15px]"
        data-cta
        data-placement="pricing"
        data-destination="browser"
        aria-label="Открыть Capybara VPN в браузере из блока тарифов"
      >
        <Icon name="globe" class="h-5 w-5 text-[#8fc3c4]" />
        Открыть в браузере
      </a>
    </div>
    <p class="mt-4 text-[13.5px] text-[#8b98a5]">
      Не уверены? Начните с бесплатного дня: 10 ГБ на тест, карта не нужна.
    </p>
  </div>
</section>
