---
import { withBase } from '../lib/url';
import { site, plans } from '../data/site';
import Icon from './Icon.astro';

const fmt = (n: number) => `${n.toLocaleString('ru-RU')} ₽`;
---

<section id="pricing" class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28" aria-labelledby="pricing-title">
  <div class="ambient left-1/2 top-24 h-[380px] w-[min(720px,100vw)] -translate-x-1/2" style="background: var(--glow)" aria-hidden="true"></div>

  <div class="reveal relative mx-auto max-w-2xl text-center">
    <p class="eyebrow justify-center">Тарифы Capybara VPN</p>
    <h2 id="pricing-title" class="mt-4 text-[clamp(1.7rem,1rem+2.2vw,2.6rem)] font-bold leading-[1.1] tracking-[-0.025em] text-ink">
      Выберите свой ритм
    </h2>
    <p class="lead mt-4 text-[16px]">
      Три честных тарифа. Везде — безлимитный трафик.
      Чем дольше срок, тем ниже цена за месяц.
    </p>
  </div>

  <div class="relative mt-14 grid gap-4 lg:grid-cols-3 lg:items-stretch">
    {
      plans.map((p, i) => (
        <article
          class:list={[
            'reveal card relative flex flex-col p-7 sm:p-8',
            p.featured
              ? 'border-conic border-brand/40 shadow-[var(--shadow-pop)] lg:-my-3 lg:py-11'
              : 'card-hover spot',
          ]}
          style={`--reveal-delay:${i * 90}ms`}
          aria-label={`Тариф ${p.days} дней за ${p.price} рублей`}
        >
          {p.featured && (
            <p class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-amber px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#3a2a05] shadow-sm">
              Максимальная экономия
            </p>
          )}
          <div class="flex items-center justify-between">
            <h3 class="mono text-[12px] font-semibold uppercase tracking-[0.14em] text-ink-2">
              {p.days} дней
            </h3>
            {p.discount > 0 ? (
              <span class="mono rounded-full border border-brand/40 bg-brand-soft px-3 py-1 text-[12.5px] font-bold text-brand">
                −{p.discount}%
              </span>
            ) : (
              <span class="mono rounded-full border border-line bg-surface-2 px-3 py-1 text-[12px] font-medium text-ink-3">
                старт
              </span>
            )}
          </div>

          <p class="display mt-5 whitespace-nowrap text-[44px] leading-none text-ink">
            <span data-count={p.price}>{p.price.toLocaleString('ru-RU')}</span><span class="ml-1 font-sans text-[0.55em] font-semibold align-baseline">₽</span>
          </p>
          <p class="mt-2.5 text-[13.5px] text-ink-3">
            {p.per30Label}
            {p.savings > 0 && <span> · экономия {fmt(p.savings)}</span>}
          </p>

          <ul class="mt-7 space-y-3 text-[14.5px] text-ink">
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"><Icon name="check" class="h-3 w-3" /></span>
              Безлимитный трафик
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"><Icon name="check" class="h-3 w-3" /></span>
              До 10 устройств
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"><Icon name="check" class="h-3 w-3" /></span>
              VLESS · 38 локаций
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"><Icon name="check" class="h-3 w-3" /></span>
              Поддержка в Telegram
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"><Icon name="check" class="h-3 w-3" /></span>
              Первый день — 10 ГБ бесплатно
            </li>
          </ul>

          <a
            href={site.browserUrl}
            target="_blank"
            rel="noopener noreferrer sponsored nofollow"
            class:list={['btn mt-8 w-full px-6 py-3.5 text-[15px]', p.featured ? 'btn-primary' : 'btn-ghost']}
            data-cta
            data-placement="pricing"
            data-destination="browser"
            data-tariff={p.id}
            aria-label={`Подключить тариф ${p.days} дней за ${p.price} рублей в браузере`}
          >
            Подключить
            <Icon name="arrow" class="btn-arrow h-4 w-4" />
          </a>
          <p class="mt-3 text-center text-[12.5px] text-ink-3">
            Оплата картой, СБП и другими способами
          </p>
        </article>
      ))
    }
  </div>

  <div class="reveal relative mx-auto mt-10 max-w-2xl text-center">
    <p class="text-[15px] text-ink-2">Продолжите в браузере — или откройте Capybara в Telegram.</p>
    <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href={site.browserUrl}
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        class="btn btn-primary px-6 py-3.5 text-[15px]"
        data-cta
        data-placement="pricing"
        data-destination="browser"
      >
        <Icon name="globe" class="h-5 w-5" />
        Продолжить в браузере
        <span class="sr-only"> — Capybara VPN</span>
      </a>
      <a
        href={site.telegramUrl}
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        class="btn btn-ghost px-6 py-3.5 text-[15px]"
        data-cta
        data-placement="pricing"
        data-destination="telegram"
      >
        <Icon name="telegram" class="h-5 w-5" />
        Открыть в Telegram
        <span class="sr-only"> — Capybara VPN</span>
      </a>
    </div>
    <p class="mt-4 text-[13.5px] text-ink-3">
      Не уверены? Начните с бесплатного дня: 10 ГБ на тест, карта не нужна.
    </p>
    <p class="mt-4 text-[13.5px] text-ink-3">
      Хотите сравнить тарифы и увидеть, что входит в подписку — <a
        href={withBase('/tarify/')}
        class="inline-flex min-h-[24px] items-center font-medium text-brand underline decoration-brand/35 underline-offset-4 transition-colors hover:decoration-brand"
        >подробный разбор тарифов</a
      >.
    </p>
  </div>
</section>
