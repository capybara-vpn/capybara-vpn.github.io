---
import { site, facts } from '../data/site';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL ?? '/';
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const logoSrc = `${b}/logo-320.png`;
---

<section id="hero" class="relative overflow-hidden pt-[200px] pb-14 sm:pt-[156px] lg:pt-[168px] lg:pb-20">
  <!-- ambient background -->
  <div class="ambient left-1/2 top-[-320px] h-[560px] w-[min(900px,100vw)] -translate-x-1/2 bg-[#60a1a3]/16" aria-hidden="true"></div>
  <div class="ambient right-[-180px] top-[30%] h-[420px] w-[min(420px,120vw)] bg-[#3c6f71]/14 max-sm:right-0 max-sm:w-[280px]" aria-hidden="true"></div>
  <div class="dotgrid absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#60a1a3]/50 to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
    <!-- Copy -->
    <div class="max-w-2xl">
      <p data-hero-in class="glass inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-[#c6d4d4]">
        <Icon name="bolt" class="h-3.5 w-3.5 text-[#8fc3c4]" />
        Быстрый VPN · VLESS · от 249 ₽
      </p>

      <h1 data-hero-in class="display mt-5 text-[44px] text-[#f2f4f3] sm:text-[64px] lg:text-[76px]">
        Интернет —<br />
        <span class="bg-gradient-to-r from-[#a8d8d9] via-[#60a1a3] to-[#4d888a] bg-clip-text text-transparent">без лишней суеты</span>
      </h1>

      <p data-hero-in class="lead mt-5 max-w-xl text-[16.5px] sm:text-lg">
        Capybara VPN — спокойный сервис для быстрого интернета. Выбираете тариф,
        открываете Telegram или браузер — и просто пользуетесь. Без сложных настроек.
      </p>

      <div data-hero-in class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={site.telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary px-7 py-4 text-[15.5px]"
          data-cta
          data-placement="hero"
          data-destination="telegram"
          aria-label="Открыть Capybara VPN в Telegram"
        >
          <Icon name="telegram" class="h-5 w-5" />
          Открыть в Telegram
        </a>
        <a
          href={site.browserUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost px-7 py-4 text-[15.5px]"
          data-cta
          data-placement="hero"
          data-destination="browser"
          aria-label="Открыть Capybara VPN в браузере"
        >
          <Icon name="globe" class="h-5 w-5 text-[#8fc3c4]" />
          Открыть в браузере
        </a>
      </div>

      <p data-hero-in class="mt-4 text-[13px] leading-relaxed text-[#8b98a5]">
        1 день бесплатно, без карты · Подключение за пару минут · Поддержка в Telegram
      </p>

      <dl data-hero-in class="mt-7 grid max-w-lg grid-cols-3 gap-2 sm:gap-3">
        <div class="hairline rounded-2xl bg-white/[0.03] px-2 py-3 sm:px-3.5">
          <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#8b98a5]">Протокол</dt>
          <dd class="mt-1 text-[15px] font-semibold text-white">{facts.protocol}</dd>
        </div>
        <div class="hairline rounded-2xl bg-white/[0.03] px-2 py-3 sm:px-3.5">
          <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#8b98a5]">Локации</dt>
          <dd class="mt-1 text-[15px] font-semibold text-white">{facts.locationsLabel}</dd>
        </div>
        <div class="hairline rounded-2xl bg-white/[0.03] px-2 py-3 sm:px-3.5">
          <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#8b98a5]">Каналы</dt>
          <dd class="mt-1 text-[15px] font-semibold text-white">до {facts.speed}</dd>
        </div>
      </dl>
    </div>

    <!-- Visual composition -->
    <div data-hero-in class="relative mx-auto flex w-full max-w-[520px] items-center justify-center" role="img" aria-label="Логотип Capybara VPN в световой композиции">
      <div class="glow-pulse absolute h-[380px] w-[380px] rounded-full bg-[#60a1a3]/22 blur-[100px] max-sm:h-[300px] max-sm:w-[300px] sm:h-[440px] sm:w-[440px]" aria-hidden="true"></div>

      <!-- orbit rings -->
      <div class="orbit-slow absolute h-[420px] w-[420px] rounded-full border border-dashed border-white/12 max-sm:h-[300px] max-sm:w-[300px] sm:h-[480px] sm:w-[480px]" aria-hidden="true">
        <span class="absolute -top-1.5 left-1/2 h-3 w-3 -translate-x-1/2 rounded-full bg-[#8fc3c4] shadow-[0_0_18px_rgba(143,195,196,0.9)]"></span>
      </div>
      <div class="orbit-rev absolute h-[330px] w-[330px] rounded-full border border-white/10 max-sm:h-[240px] max-sm:w-[240px] sm:h-[380px] sm:w-[380px]" aria-hidden="true">
        <span class="absolute top-1/2 -right-1 h-2 w-2 -translate-y-1/2 rounded-full bg-white/70"></span>
        <span class="absolute bottom-8 left-10 h-1.5 w-1.5 rounded-full bg-[#60a1a3]"></span>
      </div>
      <div class="absolute h-[250px] w-[250px] rounded-full border border-[#60a1a3]/25 max-sm:h-[200px] max-sm:w-[200px]" aria-hidden="true"></div>

      <!-- logo core -->
      <div class="relative">
        <div class="absolute -inset-8 rounded-full bg-gradient-to-b from-[#60a1a3]/30 to-transparent blur-2xl" aria-hidden="true"></div>
        <img
          src={logoSrc}
          alt="Логотип Capybara VPN — капибара"
          width="320"
          height="320"
          class="relative h-[220px] w-[220px] rounded-full object-cover shadow-[0_30px_90px_-20px_rgba(96,161,163,0.55)] ring-1 ring-white/20 sm:h-[280px] sm:w-[280px]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <!-- floating chips -->
      <div class="floaty glass absolute left-0 top-8 flex items-center gap-2 rounded-2xl px-3.5 py-2.5 text-[13px] font-semibold text-white sm:left-0" aria-hidden="true">
        <Icon name="bolt" class="h-4 w-4 text-[#8fc3c4]" />
        VLESS
      </div>
      <div class="floaty-2 glass absolute right-0 top-24 flex items-center gap-2 rounded-2xl px-3.5 py-2.5 text-[13px] font-semibold text-white sm:right-0" aria-hidden="true">
        <Icon name="server" class="h-4 w-4 text-[#8fc3c4]" />
        100+ серверов
      </div>
      <div class="floaty-3 glass absolute bottom-16 left-2 flex items-center gap-2 rounded-2xl px-3.5 py-2.5 text-[13px] font-semibold text-white sm:left-6" aria-hidden="true">
        <Icon name="globe" class="h-4 w-4 text-[#8fc3c4]" />
        38 локаций
      </div>
      <div class="floaty glass absolute right-2 bottom-6 flex items-center gap-2 rounded-2xl px-3.5 py-2.5 text-[13px] font-semibold text-white sm:right-6" style="animation-delay:2s" aria-hidden="true">
        <Icon name="gauge" class="h-4 w-4 text-[#8fc3c4]" />
        10 Гбит/с
      </div>

      <!-- price hint -->
      <a
        href="#pricing"
        class="glass group absolute -bottom-2 left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-full py-2 pl-4 pr-2.5 text-[13px] font-medium text-[#c6d4d4] transition-colors hover:text-white"
        aria-label="Перейти к тарифам от 249 рублей"
      >
        от 249 ₽ · безлим
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#60a1a3]/25 text-[#8fc3c4] transition-transform group-hover:translate-y-0.5">
          <Icon name="chevron" class="h-4 w-4" />
        </span>
      </a>
    </div>
  </div>
</section>
