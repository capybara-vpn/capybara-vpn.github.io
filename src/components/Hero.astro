---
import { site, facts } from '../data/site';
import Icon from './Icon.astro';

import { b } from '../lib/url';
---

<!--
  Centred hero (dealt: "centred headline over one window"). The window below
  is a hand-built illustration of the service experience — real locations,
  the protocol, the trial terms; it is decorative (aria-hidden) and makes no
  claims beyond the site's confirmed facts.
-->
<section id="hero" class="relative overflow-hidden pt-32 pb-16 sm:pt-36 lg:pb-24">
  <!-- ambient ground: one effect, dealt to the hero -->
  <div class="pointer-events-none absolute inset-x-0 top-0" aria-hidden="true">
    <div class="ambient left-1/2 top-[-340px] h-[540px] w-[min(960px,100vw)] -translate-x-1/2" style="background: var(--glow)"></div>
    <div class="ambient left-[max(-160px,6%)] top-[140px] h-[360px] w-[360px]" style="background: var(--glow-warm)"></div>
    <div class="ambient right-[-140px] top-[380px] h-[320px] w-[min(320px,60vw)]" style="background: var(--glow)"></div>
  </div>
  <div class="dotgrid pointer-events-none absolute inset-x-0 top-0 h-[620px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-line-strong to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6">
    <p data-hero-in class="glass inline-flex items-center gap-2 rounded-full px-4 py-2 text-[12.5px] font-medium text-ink-2" style="--hero-i:0">
      <Icon name="bolt" class="h-3.5 w-3.5 text-brand" />
      Быстрый VPN · VLESS · от 249 ₽
    </p>

    <h1 data-hero-in class="display mt-7 text-[clamp(2.4rem,1rem+5vw,4.4rem)] text-ink" style="--hero-i:1">
      Интернет —<br />
      <span class="grad-text">без лишней суеты</span>
    </h1>

    <p data-hero-in class="lead mx-auto mt-6 max-w-xl text-[16.5px] sm:text-lg" style="--hero-i:2">
      Capybara VPN — спокойный сервис для быстрого интернета. Выбираете тариф,
      открываете Telegram или браузер — и просто пользуетесь. Без сложных настроек.
    </p>

    <div data-hero-in class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--hero-i:3">
      <a
        href={site.browserUrl}
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        class="btn btn-primary w-full px-7 py-4 text-[15px] sm:w-auto"
        data-cta
        data-placement="hero"
        data-destination="browser"
      >
        <Icon name="globe" class="h-5 w-5" />
        <span class="sm:hidden">Подключить</span>
        <span class="hidden sm:inline">Продолжить в браузере</span>
        <span class="sr-only"> — Capybara VPN</span>
      </a>
      <a
        href={site.telegramUrl}
        target="_blank"
        rel="noopener noreferrer sponsored nofollow"
        class="btn btn-ghost w-full px-7 py-4 text-[15px] sm:w-auto"
        data-cta
        data-placement="hero"
        data-destination="telegram"
      >
        <Icon name="telegram" class="h-5 w-5" />
        <span class="sm:hidden">В Telegram</span>
        <span class="hidden sm:inline">Открыть в Telegram</span>
        <span class="sr-only"> — Capybara VPN</span>
      </a>
    </div>

    <p data-hero-in class="mt-4 text-[13px] leading-relaxed text-ink-3" style="--hero-i:4">
      1 день бесплатно, без карты · Подключение за пару минут · Поддержка в Telegram
    </p>

    <dl data-hero-in class="mono mx-auto mt-9 grid max-w-2xl grid-cols-2 gap-2 text-left sm:grid-cols-4" style="--hero-i:4">
      <div class="hairline rounded-2xl bg-surface/60 px-4 py-3 backdrop-blur-sm">
        <dt class="text-[10px] uppercase tracking-[0.14em] text-ink-3">Протокол</dt>
        <dd class="mt-1 text-[15px] font-semibold text-ink">{facts.protocol}</dd>
      </div>
      <div class="hairline rounded-2xl bg-surface/60 px-4 py-3 backdrop-blur-sm">
        <dt class="text-[10px] uppercase tracking-[0.14em] text-ink-3">Локации</dt>
        <dd class="mt-1 text-[15px] font-semibold text-ink">{facts.locations}</dd>
      </div>
      <div class="hairline rounded-2xl bg-surface/60 px-4 py-3 backdrop-blur-sm">
        <dt class="text-[10px] uppercase tracking-[0.14em] text-ink-3">Серверы</dt>
        <dd class="mt-1 text-[15px] font-semibold text-ink">{facts.servers}</dd>
      </div>
      <div class="hairline rounded-2xl bg-surface/60 px-4 py-3 backdrop-blur-sm">
        <dt class="text-[10px] uppercase tracking-[0.14em] text-ink-3">Каналы</dt>
        <dd class="mt-1 text-[15px] font-semibold text-ink">до {facts.speed}</dd>
      </div>
    </dl>
  </div>

  <!-- the window: a lit frame holding the connection card, fading into the ground -->
  <div data-hero-in class="relative mx-auto mt-14 max-w-4xl px-4 sm:px-6" style="--hero-i:6">
    <div class="relative" aria-hidden="true">
      <!-- lit frame with a soft fade at the foot -->
      <div
        class="absolute -inset-x-3 -top-3 bottom-[-72px] rounded-[40px] border border-line-strong sm:-inset-x-6"
        style="
          background:
            radial-gradient(60% 55% at 50% 0%, var(--glow), transparent 75%),
            linear-gradient(180deg, var(--glass-bg), transparent 78%);
          -webkit-mask-image: linear-gradient(180deg, black 62%, transparent 97%);
          mask-image: linear-gradient(180deg, black 62%, transparent 97%);
        "
      >
      </div>

      <!-- connection card -->
      <div class="glass relative overflow-hidden rounded-3xl p-5 shadow-[var(--shadow-pop)] sm:p-7">
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand/60 to-transparent"></div>

        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <picture class="block">
              <source srcset={`${b}/logo-96.webp`} type="image/webp" />
              <img src={`${b}/logo-96.png`} alt="" width="96" height="96" class="h-9 w-9 rounded-full object-cover ring-1 ring-line-strong" loading="eager" decoding="async" />
            </picture>
            <div class="text-left">
              <p class="text-[14px] font-semibold tracking-tight text-ink">Capybara VPN</p>
              <p class="ping-dot relative mt-0.5 inline-flex items-center gap-1.5 text-[11.5px] font-medium text-brand">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand"></span>
                Подключено
              </p>
            </div>
          </div>
          <span class="chip mono text-[11px] uppercase tracking-[0.12em] text-brand">VLESS</span>
        </div>

        <!-- location + latency: three slides cycling every 3.2s -->
        <div class="slide-cycle relative mt-6 h-16">
          <div class="absolute inset-0 flex items-center justify-between rounded-2xl border border-line bg-surface-2/70 px-4 sm:px-5" style="animation-delay: 0s">
            <span class="flex items-center gap-3">
              <span class="text-[24px] leading-none">🇳🇱</span>
              <span class="text-[17px] font-semibold tracking-tight text-ink">Нидерланды</span>
            </span>
            <span class="mono text-[13px] font-semibold text-brand">24 мс</span>
          </div>
          <div class="absolute inset-0 flex items-center justify-between rounded-2xl border border-line bg-surface-2/70 px-4 sm:px-5" style="animation-delay: -3.2s">
            <span class="flex items-center gap-3">
              <span class="text-[24px] leading-none">🇩🇪</span>
              <span class="text-[17px] font-semibold tracking-tight text-ink">Германия</span>
            </span>
            <span class="mono text-[13px] font-semibold text-brand">31 мс</span>
          </div>
          <div class="absolute inset-0 flex items-center justify-between rounded-2xl border border-line bg-surface-2/70 px-4 sm:px-5" style="animation-delay: -6.4s">
            <span class="flex items-center gap-3">
              <span class="text-[24px] leading-none">🇸🇪</span>
              <span class="text-[17px] font-semibold tracking-tight text-ink">Швеция</span>
            </span>
            <span class="mono text-[13px] font-semibold text-brand">28 мс</span>
          </div>
        </div>

        <!-- connection switch: on (static — a toggle knob has no business bobbing) -->
        <div class="mt-5 flex items-center justify-between px-1">
          <span class="text-[13.5px] font-medium text-ink-2">Соединение</span>
          <span class="relative inline-flex h-8 w-14 shrink-0 rounded-full bg-brand shadow-[inset_0_1px_0_rgba(255,255,255,.25)]">
            <span class="absolute right-1 top-1/2 h-6 w-6 -translate-y-1/2 rounded-full bg-white shadow-md"></span>
          </span>
        </div>

        <!-- live line -->
        <svg class="mt-5 h-14 w-full" viewBox="0 0 320 56" fill="none" preserveAspectRatio="none">
          <defs>
            <linearGradient id="sparkfill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--brand)" stop-opacity="0.28" />
              <stop offset="100%" stop-color="var(--brand)" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d="M0 44 L30 40 L55 46 L80 30 L110 36 L140 20 L170 28 L200 14 L235 24 L265 10 L295 18 L320 8 L320 56 L0 56 Z" fill="url(#sparkfill)" />
          <path class="spark-flow" d="M0 44 L30 40 L55 46 L80 30 L110 36 L140 20 L170 28 L200 14 L235 24 L265 10 L295 18 L320 8" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>

        <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-4">
          <div class="flex flex-wrap gap-1.5">
            <span class="chip text-[11.5px]">RAM-only</span>
            <span class="chip text-[11.5px]">Безлимит</span>
            <span class="chip text-[11.5px]">до 10 Гбит/с</span>
          </div>
          <span class="chip border-brand/40 bg-brand-soft text-[12px] font-semibold text-brand">
            от 249 ₽ · безлим
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
